-- ============================================================================
-- 26. STORED PROCEDURES
-- ============================================================================

/*
LANGUAGES: SQL (Snowflake Scripting), Python (Snowpark), JavaScript, Java, Scala

PROCEDURE vs FUNCTION
  Procedure : CALLed on its own, can run DDL/DML, control flow, transactions;
              returns a single value or a table.
  Function  : used INSIDE a query (SELECT f(x)), must return a value per row,
              cannot run DML.

OWNER'S RIGHTS vs CALLER'S RIGHTS
  EXECUTE AS OWNER  (default): runs with the owner role's privileges -
                    callers can do things through the proc they could not do
                    directly (controlled privilege elevation). Used by tasks.
  EXECUTE AS CALLER : runs with the caller's privileges and session.

SNOWFLAKE SCRIPTING BUILDING BLOCKS
  DECLARE / LET var := ...      variables       (reference in SQL as :var)
  IF / ELSEIF / ELSE / CASE     branching
  FOR / WHILE / REPEAT / LOOP   loops (FOR r IN cursor DO ... END FOR)
  EXECUTE IMMEDIATE :sql        dynamic SQL
  RESULTSET / RETURN TABLE()    return query results
  SQLROWCOUNT, SQLFOUND         rows affected by last DML
  EXCEPTION WHEN ... THEN       error handling (SQLCODE, SQLERRM, SQLSTATE)
  RAISE                         re-throw / throw custom exception
*/

/* Dynamic SQL + custom exception + binding variables safely */
CREATE OR REPLACE PROCEDURE sales_db.audit.sp_row_count(p_table STRING)
RETURNS NUMBER
LANGUAGE SQL
AS
$$
DECLARE
    v_cnt NUMBER;
    empty_table EXCEPTION (-20001, 'Table is empty');
BEGIN
    -- IDENTIFIER() safely uses a variable as an object name (avoids SQL injection)
    SELECT COUNT(*) INTO :v_cnt FROM IDENTIFIER(:p_table);
    IF (v_cnt = 0) THEN
        RAISE empty_table;
    END IF;
    RETURN v_cnt;
EXCEPTION
    WHEN empty_table THEN
        RETURN -1;
END;
$$;

CALL sales_db.audit.sp_row_count('sales_db.curated.orders');

/* Return a table from a procedure */
CREATE OR REPLACE PROCEDURE sales_db.mart.sp_top_customers(p_limit NUMBER)
RETURNS TABLE (customer_id NUMBER, total NUMBER)
LANGUAGE SQL
AS
$$
DECLARE
    res RESULTSET DEFAULT (
        SELECT customer_id, SUM(amount) AS total
        FROM sales_db.curated.orders
        GROUP BY customer_id
        ORDER BY total DESC
        LIMIT :p_limit);
BEGIN
    RETURN TABLE(res);
END;
$$;

/* Python (Snowpark) procedure - DataFrame code is pushed down as SQL */
CREATE OR REPLACE PROCEDURE sales_db.mart.sp_py_region_summary()
RETURNS STRING
LANGUAGE PYTHON
RUNTIME_VERSION = '3.11'
PACKAGES = ('snowflake-snowpark-python')
HANDLER = 'run'
AS
$$
from snowflake.snowpark.functions import col, sum as sum_

def run(session):
    df = (session.table("SALES_DB.CURATED.ORDERS")
                 .group_by(col("REGION"))
                 .agg(sum_(col("AMOUNT")).alias("REVENUE")))
    df.write.mode("overwrite").save_as_table("SALES_DB.MART.REGION_SUMMARY")
    return f"rows written: {df.count()}"
$$;

