-- ============================================================================
-- 10. STORAGE INTEGRATION & STAGES (AWS S3)
-- ============================================================================

/*
STAGE = a pointer to a location where files live before loading (or after
unloading).
  +----------------------+-----------------+--------------------------------+
  | Stage type           | Reference       | Notes                          |
  +----------------------+-----------------+--------------------------------+
  | User stage           | @~              | one per user, auto-created     |
  | Table stage          | @%table_name    | one per table, auto-created    |
  | Named internal stage | @my_int_stage   | Snowflake-managed storage      |
  | Named external stage | @ext_s3_stage   | your S3 bucket                 |
  +----------------------+-----------------+--------------------------------+

STORAGE INTEGRATION = account-level object that holds an AWS IAM role
trust relationship. Why use it instead of access keys in the stage?
  - No secrets stored in Snowflake objects or SQL scripts
  - Central control: STORAGE_ALLOWED_LOCATIONS restricts which buckets
    stages may point to
  - Key rotation is handled by AWS IAM, not by editing stages

SETUP FLOW (AWS) - frequently asked "walk me through it":
  1. In AWS: create an IAM policy (s3:GetObject, s3:GetObjectVersion,
     s3:ListBucket, + s3:PutObject/DeleteObject if unloading/purging)
     and an IAM role with that policy.
  2. In Snowflake: CREATE STORAGE INTEGRATION with the role ARN.
  3. DESC INTEGRATION -> copy STORAGE_AWS_IAM_USER_ARN and
     STORAGE_AWS_EXTERNAL_ID.
  4. In AWS: edit the role's TRUST POLICY to allow that IAM user ARN
     with that external ID.
  5. In Snowflake: CREATE STAGE ... STORAGE_INTEGRATION = ...
  6. Grant USAGE on the integration/stage to the loading role.
*/

USE ROLE ACCOUNTADMIN;   -- integrations need ACCOUNTADMIN (or CREATE INTEGRATION)

CREATE OR REPLACE STORAGE INTEGRATION s3_int
  TYPE = EXTERNAL_STAGE
  STORAGE_PROVIDER = 'S3'
  ENABLED = TRUE
  STORAGE_AWS_ROLE_ARN = 'arn:aws:iam::123456789012:role/snowflake_s3_role'
  STORAGE_ALLOWED_LOCATIONS = ('s3://acme-datalake/sales/')
  STORAGE_BLOCKED_LOCATIONS = ('s3://acme-datalake/sales/restricted/');

DESC STORAGE INTEGRATION s3_int;
-- copy STORAGE_AWS_IAM_USER_ARN + STORAGE_AWS_EXTERNAL_ID into the IAM trust policy

GRANT USAGE ON INTEGRATION s3_int TO ROLE SYSADMIN;
USE ROLE SYSADMIN;

/* External stage on S3 */
CREATE OR REPLACE STAGE sales_db.raw.ext_s3_stage
  URL = 's3://acme-datalake/sales/'
  STORAGE_INTEGRATION = s3_int
  DIRECTORY = (ENABLE = TRUE)          -- optional: queryable file listing
  COMMENT = 'Landing zone for sales files';

/* Internal named stage */
CREATE OR REPLACE STAGE sales_db.raw.my_int_stage;

/* Upload/download local files (SnowSQL / Python connector - not in worksheets) */
-- PUT file://C:\data\orders_2026_10_01.csv @sales_db.raw.my_int_stage/orders/ AUTO_COMPRESS = TRUE;
-- GET @sales_db.raw.my_int_stage/orders/ file://C:\download\;

/* Explore files */
LIST @ext_s3_stage/orders/2026/10/;
SELECT * FROM DIRECTORY(@ext_s3_stage);       -- needs DIRECTORY enabled

/* Query staged files directly BEFORE loading (great for profiling) */
SELECT $1, $2, $3, METADATA$FILENAME, METADATA$FILE_ROW_NUMBER
FROM @ext_s3_stage/orders/ (FILE_FORMAT => 'csv_ff')
LIMIT 10;

-- ============================================================================
-- 11. FILE FORMATS
-- ============================================================================

CREATE OR REPLACE FILE FORMAT sales_db.raw.csv_ff
  TYPE = 'CSV'
  FIELD_DELIMITER = ','
  SKIP_HEADER = 1                      -- or PARSE_HEADER = TRUE for MATCH_BY_COLUMN_NAME
  FIELD_OPTIONALLY_ENCLOSED_BY = '"'
  NULL_IF = ('NULL', 'null', '')
  EMPTY_FIELD_AS_NULL = TRUE
  TRIM_SPACE = TRUE
  ERROR_ON_COLUMN_COUNT_MISMATCH = TRUE
  DATE_FORMAT = 'AUTO'
  TIMESTAMP_FORMAT = 'AUTO'
  COMPRESSION = 'AUTO';

CREATE OR REPLACE FILE FORMAT sales_db.raw.json_ff
  TYPE = 'JSON'
  STRIP_OUTER_ARRAY = TRUE             -- [ {..}, {..} ] -> one row per object
  COMPRESSION = 'AUTO';

CREATE OR REPLACE FILE FORMAT sales_db.raw.parquet_ff
  TYPE = 'PARQUET'
  USE_VECTORIZED_SCANNER = TRUE;       -- faster Parquet scans

/*
FILE FORMAT CHOICE (interview tip):
  - Parquet: columnar, typed, compressed -> best for large analytic loads;
    supports MATCH_BY_COLUMN_NAME and INFER_SCHEMA.
  - JSON: flexible, land in VARIANT; good for APIs/events.
  - CSV: universal but fragile (delimiters, quotes, no types).
*/

-- ============================================================================
-- 12. BULK LOADING WITH COPY INTO [***]
-- ============================================================================

/*
HOW COPY INTO WORKS
  - Runs on YOUR warehouse. Files are distributed across the warehouse's
    threads; each file is loaded by one thread (large files are split
    internally by Snowflake only for some formats).
  - Rough parallelism: an XS warehouse loads ~8 files at a time; each
    size up doubles that.  => 1 huge 50 GB file loads SLOWLY;
                              500 files of 100 MB load FAST.

FILE SIZING BEST PRACTICE [***]
  - Aim for 100-250 MB COMPRESSED per file.
  - Too many tiny files (KBs): overhead per file, more cloud services
    cost, slow LIST operations.
  - One giant file: no parallelism.

LOAD METADATA (deduplication) [***]
  - Snowflake remembers which files were loaded INTO EACH TABLE for 64 DAYS
    (file name + ETag/checksum).
  - Re-running the same COPY skips already-loaded files -> COPY is
    idempotent by default.
  - FORCE = TRUE reloads everything (creates DUPLICATES - use carefully).
  - Files older than 64 days with unknown status are skipped unless
    LOAD_UNCERTAIN_FILES = TRUE.
  - Modifying a file (new ETag) means it will be loaded AGAIN.

ON_ERROR OPTIONS
  ABORT_STATEMENT (default for COPY) : stop on first error, nothing loaded
  CONTINUE                           : skip bad ROWS, load the rest
  SKIP_FILE (default for Snowpipe)   : skip the whole file if any error
  SKIP_FILE_10 / SKIP_FILE_5%        : skip file only past a threshold
*/

/* Raw landing table: keep the full record + lineage columns */
CREATE OR REPLACE TRANSIENT TABLE sales_db.raw.raw_orders (
    record        VARIANT,
    src_file      STRING,
    src_row       NUMBER,
    file_ts       TIMESTAMP_LTZ,
    load_ts       TIMESTAMP_LTZ DEFAULT CURRENT_TIMESTAMP()
);

/* 1. Load JSON with lineage metadata */
COPY INTO sales_db.raw.raw_orders (record, src_file, src_row, file_ts)
FROM (
    SELECT $1,
           METADATA$FILENAME,
           METADATA$FILE_ROW_NUMBER,
           METADATA$FILE_LAST_MODIFIED
    FROM @ext_s3_stage/orders/
)
FILE_FORMAT = (FORMAT_NAME = 'json_ff')
PATTERN = '.*orders_.*[.]json[.]gz'
ON_ERROR = 'SKIP_FILE';

/* 2. Validate first - a dry run, nothing is loaded.
      (VALIDATION_MODE works only on a plain COPY, not COPY with a SELECT) */
CREATE OR REPLACE TABLE sales_db.stage.customers (
    customer_id INT, name STRING, email STRING, region STRING,
    updated_at TIMESTAMP_NTZ
);

COPY INTO sales_db.stage.customers
FROM @ext_s3_stage/customers_csv/
FILE_FORMAT = (FORMAT_NAME = 'csv_ff')
VALIDATION_MODE = 'RETURN_ERRORS';         -- or 'RETURN_10_ROWS' to preview

/* 3. Load Parquet straight into typed columns by name */

COPY INTO sales_db.stage.customers
FROM @ext_s3_stage/customers/
FILE_FORMAT = (FORMAT_NAME = 'parquet_ff')
MATCH_BY_COLUMN_NAME = CASE_INSENSITIVE;

/* 4. CSV with column mapping & light transformation */
COPY INTO sales_db.stage.customers (customer_id, name, email, region)
FROM (
    SELECT $1::INT, INITCAP(TRIM($2)), LOWER($3), UPPER($4)
    FROM @ext_s3_stage/customers_csv/
)
FILE_FORMAT = (FORMAT_NAME = 'csv_ff')
ON_ERROR = 'CONTINUE';

/* 5. See errors of the last COPY (rows rejected with ON_ERROR=CONTINUE) */
SELECT * FROM TABLE(VALIDATE(sales_db.stage.customers, JOB_ID => '_last'));

/* 6. Load history (14 days in INFORMATION_SCHEMA, 365 in ACCOUNT_USAGE) */
SELECT file_name, status, row_count, row_parsed, first_error_message, last_load_time
FROM TABLE(INFORMATION_SCHEMA.COPY_HISTORY(
    TABLE_NAME => 'SALES_DB.RAW.RAW_ORDERS',
    START_TIME => DATEADD(hour, -24, CURRENT_TIMESTAMP())));

/* Other useful COPY options */
-- PURGE = TRUE               delete files from stage after a successful load
-- SIZE_LIMIT = 5000000000    stop after ~5 GB in this run (throttling)
-- TRUNCATECOLUMNS = TRUE     cut strings that are too long instead of failing
-- INCLUDE_METADATA = (col = METADATA$FILENAME)  with MATCH_BY_COLUMN_NAME

-- ============================================================================
-- 13. SNOWPIPE & SNOWPIPE STREAMING [***]
-- ============================================================================

/*
SNOWPIPE = continuous, serverless file ingestion.
  - Definition is just a COPY INTO statement wrapped in a PIPE.
  - Triggered when files land in S3: S3 event notification -> SQS queue
    (owned by Snowflake) -> pipe loads the file. Latency: ~1 minute.
  - Uses SERVERLESS compute (no warehouse); billed by Snowflake-managed
    compute usage plus a per-file overhead (Snowflake has been moving
    Snowpipe to simpler per-GB pricing - check your contract/pricing page).
  - Load metadata kept on the PIPE for 14 days (dedup window).
  - Default ON_ERROR = SKIP_FILE.
  - Files are loaded in roughly arrival order, NOT guaranteed ordering.

COPY INTO vs SNOWPIPE
  +-----------------+-----------------------------+---------------------------+
  |                 | COPY INTO (batch)           | SNOWPIPE (continuous)     |
  +-----------------+-----------------------------+---------------------------+
  | Compute         | Your warehouse              | Serverless                |
  | Trigger         | Manual / Task / Airflow     | S3 event (SQS) or REST API|
  | Latency         | Schedule-based              | ~1 minute                 |
  | Dedup metadata  | 64 days (per table)         | 14 days (per pipe)        |
  | Transactions    | One per COPY statement      | Per file/micro-batch      |
  | Best for        | Large scheduled batches     | Steady trickle of files   |
  +-----------------+-----------------------------+---------------------------+

SNOWPIPE STREAMING
  - Row-level ingestion via the Snowpipe Streaming SDK or the Kafka
    connector (no files staged). Latency in seconds.
  - Cheapest + fastest option for Kafka / event streams.
  - Pairs well with Dynamic Tables for near-real-time pipelines.

SNOWPIPE COST TIP [***]: Many tiny files are expensive with Snowpipe
(per-file overhead). Batch files upstream to ~100-250 MB or roughly one
file per minute per producer.
*/

CREATE OR REPLACE PIPE sales_db.raw.orders_pipe
  AUTO_INGEST = TRUE
  COMMENT = 'Auto-ingest order JSON files from S3'
AS
COPY INTO sales_db.raw.raw_orders (record, src_file, src_row, file_ts)
FROM (
    SELECT $1, METADATA$FILENAME, METADATA$FILE_ROW_NUMBER,
           METADATA$FILE_LAST_MODIFIED
    FROM @ext_s3_stage/orders/
)
FILE_FORMAT = (FORMAT_NAME = 'json_ff');

/* Get the SQS ARN -> configure S3 bucket "Event notification"
   (ObjectCreated) on prefix sales/orders/ to send to this queue */
SHOW PIPES LIKE 'orders_pipe';            -- column: notification_channel
DESC PIPE sales_db.raw.orders_pipe;

/* Pipe health */
SELECT SYSTEM$PIPE_STATUS('sales_db.raw.orders_pipe');
-- returns JSON: executionState, pendingFileCount, lastIngestedTimestamp, error...

/* Load files that already existed before the pipe was created
   (REFRESH only looks back 7 days) */
ALTER PIPE sales_db.raw.orders_pipe REFRESH;
ALTER PIPE sales_db.raw.orders_pipe REFRESH PREFIX = 'orders/2026/10/';

/* What failed? */
SELECT *
FROM TABLE(INFORMATION_SCHEMA.VALIDATE_PIPE_LOAD(
    PIPE_NAME  => 'sales_db.raw.orders_pipe',
    START_TIME => DATEADD(hour, -24, CURRENT_TIMESTAMP())));

/* Pause / resume (e.g. during maintenance of the target table) */
ALTER PIPE sales_db.raw.orders_pipe SET PIPE_EXECUTION_PAUSED = TRUE;
ALTER PIPE sales_db.raw.orders_pipe SET PIPE_EXECUTION_PAUSED = FALSE;

/* Error notifications -> SNS topic */
CREATE OR REPLACE NOTIFICATION INTEGRATION pipe_error_int
  TYPE = QUEUE
  DIRECTION = OUTBOUND
  NOTIFICATION_PROVIDER = 'AWS_SNS'
  AWS_SNS_TOPIC_ARN = 'arn:aws:sns:us-east-1:123456789012:snowpipe-errors'
  AWS_SNS_ROLE_ARN  = 'arn:aws:iam::123456789012:role/snowflake_sns_role'
  ENABLED = TRUE;

ALTER PIPE sales_db.raw.orders_pipe SET ERROR_INTEGRATION = pipe_error_int;

/* Cost of pipes */
SELECT pipe_name, SUM(credits_used) AS credits, SUM(bytes_inserted)/POWER(1024,3) AS gb,
       SUM(files_inserted) AS files
FROM SNOWFLAKE.ACCOUNT_USAGE.PIPE_USAGE_HISTORY
WHERE start_time >= DATEADD(day, -30, CURRENT_TIMESTAMP())
GROUP BY pipe_name ORDER BY credits DESC;

-- ============================================================================
-- 14. SCHEMA EVOLUTION
-- ============================================================================

/*
Source systems add columns. Options:
  1. Land as VARIANT (raw layer) - new keys never break the load. [preferred]
  2. ENABLE_SCHEMA_EVOLUTION = TRUE on the table + MATCH_BY_COLUMN_NAME in
     COPY/Snowpipe -> Snowflake adds new columns automatically and drops
     NOT NULL on missing columns (Parquet/Avro/ORC/CSV with PARSE_HEADER).
  3. INFER_SCHEMA + USING TEMPLATE to create the table from file metadata.
*/

CREATE OR REPLACE TABLE sales_db.raw.raw_products
USING TEMPLATE (
    SELECT ARRAY_AGG(OBJECT_CONSTRUCT(*))
    FROM TABLE(INFER_SCHEMA(
        LOCATION    => '@ext_s3_stage/products/',
        FILE_FORMAT => 'parquet_ff'))
);

ALTER TABLE sales_db.raw.raw_products SET ENABLE_SCHEMA_EVOLUTION = TRUE;

COPY INTO sales_db.raw.raw_products
FROM @ext_s3_stage/products/
FILE_FORMAT = (FORMAT_NAME = 'parquet_ff')
MATCH_BY_COLUMN_NAME = CASE_INSENSITIVE;   -- new columns get added automatically

-- ============================================================================
-- 15. EXTERNAL TABLES & ICEBERG TABLES
-- ============================================================================

/*
EXTERNAL TABLE
  - Read-only table over files in S3; data is NOT loaded into Snowflake.
  - Slower than native tables (no micro-partition metadata, limited pruning)
    - define PARTITION columns from the file path to get pruning.
  - Use for: rarely queried archive data, exploring the lake, avoiding
    duplicate storage.

ICEBERG TABLE (Apache Iceberg open table format)
  - Data + metadata stored as Parquet/Iceberg in YOUR S3 bucket
    (via an EXTERNAL VOLUME).
  - Snowflake-managed catalog: full DML, near-native performance, and other
    engines (Spark, Trino, Athena) can read the same data.
  - You pay S3 storage to AWS, compute to Snowflake.
  - Interview angle: "How do you avoid vendor lock-in / share data with a
    Spark/EMR team?" -> Iceberg tables.
*/

/* Files laid out as .../clickstream/2026-10-01/part-0001.parquet
   (adjust the SPLIT_PART index to match your folder layout) */
CREATE OR REPLACE EXTERNAL TABLE sales_db.raw.ext_clickstream (
    event_date DATE   AS (TO_DATE(SPLIT_PART(METADATA$FILENAME, '/', 2), 'YYYY-MM-DD')),
    user_id    STRING AS (value:user_id::STRING),
    page       STRING AS (value:page::STRING)
)
PARTITION BY (event_date)                    -- enables pruning on the path
LOCATION = @ext_s3_stage/clickstream/
FILE_FORMAT = (FORMAT_NAME = 'parquet_ff')
AUTO_REFRESH = TRUE;                          -- metadata refresh via S3 events

SELECT page, COUNT(*) FROM sales_db.raw.ext_clickstream
WHERE event_date = '2026-10-01' GROUP BY page;

/* Iceberg: external volume -> Iceberg table */
USE ROLE ACCOUNTADMIN;
CREATE OR REPLACE EXTERNAL VOLUME iceberg_vol
  STORAGE_LOCATIONS = ((
      NAME = 'iceberg-s3'
      STORAGE_PROVIDER = 'S3'
      STORAGE_BASE_URL = 's3://acme-lakehouse/iceberg/'
      STORAGE_AWS_ROLE_ARN = 'arn:aws:iam::123456789012:role/snowflake_iceberg_role'
  ));
GRANT USAGE ON EXTERNAL VOLUME iceberg_vol TO ROLE SYSADMIN;
USE ROLE SYSADMIN;

CREATE OR REPLACE ICEBERG TABLE sales_db.curated.orders_iceberg (
    order_id NUMBER, customer_id NUMBER, amount NUMBER(12,2), order_ts TIMESTAMP_NTZ
)
CATALOG = 'SNOWFLAKE'
EXTERNAL_VOLUME = 'iceberg_vol'
BASE_LOCATION = 'orders/';

