-- ============================================================================
-- 17. STREAMS (CHANGE DATA CAPTURE) [***]
-- ============================================================================

/*
WHAT IS A STREAM?
  A stream is a BOOKMARK (offset) on a table. It does not copy data.
  Querying it returns the rows that changed between the offset and now,
  by comparing table versions (using Time Travel metadata).

STREAM TYPES
  +--------------+-------------------------------+---------------------------+
  | Type         | Captures                      | Use for                   |
  +--------------+-------------------------------+---------------------------+
  | Standard     | INSERT, UPDATE, DELETE        | CDC on mutable tables     |
  |              | (net changes)                 |                           |
  | Append-only  | INSERT only                   | raw/landing tables -      |
  |              |                               | cheaper & faster [***]    |
  | Insert-only  | INSERT only                   | External / Iceberg tables |
  +--------------+-------------------------------+---------------------------+

METADATA COLUMNS
  METADATA$ACTION   'INSERT' or 'DELETE'
  METADATA$ISUPDATE TRUE if the row is part of an UPDATE
                    (an UPDATE appears as a DELETE + INSERT pair)
  METADATA$ROW_ID   stable unique row id

  How DML shows up in a standard stream:
    INSERT  -> 1 row : ACTION=INSERT, ISUPDATE=FALSE
    DELETE  -> 1 row : ACTION=DELETE, ISUPDATE=FALSE
    UPDATE  -> 2 rows: ACTION=DELETE, ISUPDATE=TRUE  (old values)
                       ACTION=INSERT, ISUPDATE=TRUE  (new values)
  NET CHANGES: a row inserted and then deleted between two consumptions
  does not appear at all.

HOW THE OFFSET MOVES [***]
  - SELECT from a stream does NOT move the offset (you can preview freely).
  - Using the stream in a DML statement (INSERT/MERGE/...) that COMMITS
    moves the offset to "now". If the DML fails/rolls back -> offset stays,
    data is re-processed next run (exactly-once friendly).
  - Inside an explicit transaction (BEGIN ... COMMIT), all statements see
    the SAME stream contents; the offset moves at COMMIT. Use this to load
    multiple targets from one stream.
  - One stream = one consumer. Two independent consumers need two streams.

STALENESS [***]
  - A stream becomes STALE if its offset is older than the table's data
    retention period (it can no longer read the old versions).
  - To prevent this, Snowflake automatically extends retention for tables
    with streams up to MAX_DATA_EXTENSION_TIME_IN_DAYS (default 14 days).
  - Stale stream = must be recreated; changes in the gap are lost unless
    you reconcile from source/Time Travel. Monitor SHOW STREAMS -> STALE_AFTER.
*/

/* Append-only stream on the raw landing table */
CREATE OR REPLACE STREAM sales_db.raw.raw_orders_stream
ON TABLE sales_db.raw.raw_orders
APPEND_ONLY = TRUE;

/* Standard stream on a mutable table (e.g. replicated source table) */
CREATE OR REPLACE STREAM sales_db.stage.customers_stream
ON TABLE sales_db.stage.customers;

/* Preview changes (does NOT consume) */
SELECT customer_id, name, METADATA$ACTION, METADATA$ISUPDATE
FROM sales_db.stage.customers_stream;

/* Is there anything to process? (cheap - runs in cloud services) */
SELECT SYSTEM$STREAM_HAS_DATA('sales_db.stage.customers_stream');

/* Monitor staleness */
SHOW STREAMS IN SCHEMA sales_db.raw;          -- check STALE, STALE_AFTER columns

/* Skip/advance a stream without processing (e.g. after a manual backfill):
   a DML that reads the stream but inserts nothing still moves the offset */
CREATE TEMPORARY TABLE stream_sink LIKE sales_db.raw.raw_orders;
INSERT INTO stream_sink
SELECT record, src_file, src_row, file_ts, load_ts
FROM sales_db.raw.raw_orders_stream WHERE 1 = 0;

/* Alternative to streams: CHANGES clause (ad-hoc CDC between two points) */
ALTER TABLE sales_db.stage.customers SET CHANGE_TRACKING = TRUE;
SELECT *
FROM sales_db.stage.customers
CHANGES (INFORMATION => DEFAULT)
AT (TIMESTAMP => DATEADD(hour, -6, CURRENT_TIMESTAMP()));

-- ============================================================================
-- 18. TASKS & TASK GRAPHS (DAGs) [***]
-- ============================================================================

/*
WHAT IS A TASK?
  A scheduled (or triggered) unit of work: one SQL statement, a CALL to a
  stored procedure, or a Snowflake Scripting block.

COMPUTE OPTIONS
  - User-managed : WAREHOUSE = transform_wh. You control size; billed as
                   normal warehouse time (60s minimum per resume).
  - Serverless   : omit WAREHOUSE. Snowflake sizes compute automatically
                   (based on history) and bills per second of actual use.
                   Good for short, frequent tasks that would waste the
                   60s minimum / idle time of a warehouse.

SCHEDULING OPTIONS
  - SCHEDULE = '5 MINUTE'                       fixed interval
  - SCHEDULE = 'USING CRON 0 2 * * * UTC'       cron expression
  - No SCHEDULE + WHEN SYSTEM$STREAM_HAS_DATA   TRIGGERED task: runs when
                                                new data arrives in the stream
  - AFTER parent_task                           child in a task graph

KEY BEHAVIOURS [***]
  - Tasks are created SUSPENDED -> ALTER TASK ... RESUME.
  - WHEN condition is evaluated in cloud services; if FALSE, the run is
    skipped and NO warehouse is started -> no compute cost.
  - Only one instance of a graph runs at a time unless
    ALLOW_OVERLAPPING_EXECUTION = TRUE (root task). If a run takes longer
    than the interval, the next run is skipped.
  - SUSPEND_TASK_AFTER_NUM_FAILURES (default 10): auto-suspends after N
    consecutive failures.
  - TASK_AUTO_RETRY_ATTEMPTS: automatically retry a failed graph run.
  - USER_TASK_TIMEOUT_MS (default 1 hour): kills a long-running task.
  - Tasks run with the privileges of the task OWNER role. The owner needs
    the account-level EXECUTE TASK privilege (and EXECUTE MANAGED TASK for
    serverless).

TASK GRAPH (DAG) RULES
  - One ROOT task holds the schedule; children use AFTER.
  - A child can have multiple parents (runs when ALL parents succeed).
  - Up to 1000 tasks per graph.
  - FINALIZER task: runs at the end of every graph run, success or failure
    -> perfect for cleanup and notifications.
  - Modify/resume children only when the root is SUSPENDED.
*/

/* Simple scheduled task with a stream gate */
CREATE OR REPLACE TASK sales_db.stage.t_merge_customers
  WAREHOUSE = transform_wh
  SCHEDULE  = '15 MINUTE'
  WHEN SYSTEM$STREAM_HAS_DATA('sales_db.stage.customers_stream')
AS
  CALL sales_db.curated.sp_scd2_customer();        -- defined in section 21

/* Serverless task */
CREATE OR REPLACE TASK sales_db.stage.t_cleanup_logs
  SCHEDULE = 'USING CRON 0 3 * * * UTC'
  USER_TASK_MANAGED_INITIAL_WAREHOUSE_SIZE = 'XSMALL'
AS
  DELETE FROM sales_db.audit.pipeline_run_log
  WHERE start_ts < DATEADD(day, -90, CURRENT_TIMESTAMP());

/* Triggered task - no schedule, fires when the stream has data */
CREATE OR REPLACE TASK sales_db.raw.t_on_new_orders
  WAREHOUSE = transform_wh
  WHEN SYSTEM$STREAM_HAS_DATA('sales_db.raw.raw_orders_stream')
AS
  CALL sales_db.curated.sp_process_orders();       -- defined in section 22

/* Task graph:
        t_root_daily
          /       \
   t_load_a      t_load_b
          \       /
         t_build_mart
   + t_finalize (finalizer - always runs)                          */
CREATE OR REPLACE TASK t_root_daily
  WAREHOUSE = transform_wh
  SCHEDULE  = 'USING CRON 0 1 * * * America/New_York'
  SUSPEND_TASK_AFTER_NUM_FAILURES = 3
  TASK_AUTO_RETRY_ATTEMPTS = 2
AS
  SELECT 1;                                          -- root can be a no-op starter

CREATE OR REPLACE TASK t_load_a  WAREHOUSE = transform_wh AFTER t_root_daily
AS CALL load_source_a();

CREATE OR REPLACE TASK t_load_b  WAREHOUSE = transform_wh AFTER t_root_daily
AS CALL load_source_b();

CREATE OR REPLACE TASK t_build_mart WAREHOUSE = transform_wh AFTER t_load_a, t_load_b
AS CALL build_mart();

CREATE OR REPLACE TASK t_finalize
  WAREHOUSE = transform_wh
  FINALIZE  = t_root_daily
AS
  CALL notify_run_status();

/* Resume every task in the graph in one go (root last automatically) */
SELECT SYSTEM$TASK_DEPENDENTS_ENABLE('t_root_daily');

/* Run once manually (testing / re-run after a fix) */
EXECUTE TASK t_root_daily;

/* Suspend before changing any task in the graph */
ALTER TASK t_root_daily SUSPEND;

/* Monitor */
SELECT name, state, scheduled_time, completed_time, error_code, error_message
FROM TABLE(INFORMATION_SCHEMA.TASK_HISTORY(
    SCHEDULED_TIME_RANGE_START => DATEADD(day, -1, CURRENT_TIMESTAMP()),
    RESULT_LIMIT => 100))
ORDER BY scheduled_time DESC;

SELECT * FROM TABLE(INFORMATION_SCHEMA.COMPLETE_TASK_GRAPHS())
ORDER BY completed_time DESC;

