-- ============================================================================
-- 33. SECURITY: RBAC, MASKING, ROW ACCESS, TAGS, NETWORK POLICIES [***]
-- ============================================================================

/*
ACCESS CONTROL MODEL
  - Privileges are granted to ROLES; roles are granted to USERS or other ROLES.
  - Every object has exactly one OWNER role.
  - Discretionary (DAC: owner grants access) + Role-based (RBAC).

SYSTEM ROLES
  ACCOUNTADMIN   top-level; use rarely, MFA, at least 2 people
     ├─ SECURITYADMIN  manage grants (MANAGE GRANTS)
     │     └─ USERADMIN  create users & roles
     └─ SYSADMIN       owns databases, warehouses
  PUBLIC         granted to everyone

RECOMMENDED ROLE DESIGN [***] - "access roles" + "functional roles"
  Access roles (database roles or account roles) hold object privileges:
    SALES_DB_RO, SALES_DB_RW, SALES_DB_ADMIN
  Functional roles map to jobs and inherit access roles:
    DATA_ENGINEER -> SALES_DB_RW ; ANALYST -> SALES_DB_RO
  All custom roles roll up to SYSADMIN so admins can manage objects.
  Use FUTURE GRANTS so new tables are automatically accessible.
*/

USE ROLE SECURITYADMIN;

CREATE ROLE IF NOT EXISTS sales_db_ro;
CREATE ROLE IF NOT EXISTS sales_db_rw;
CREATE ROLE IF NOT EXISTS data_engineer;
CREATE ROLE IF NOT EXISTS analyst;

/* Access role: read-only */
GRANT USAGE ON DATABASE sales_db                         TO ROLE sales_db_ro;
GRANT USAGE ON ALL SCHEMAS IN DATABASE sales_db          TO ROLE sales_db_ro;
GRANT SELECT ON ALL TABLES IN DATABASE sales_db          TO ROLE sales_db_ro;
GRANT SELECT ON FUTURE TABLES IN DATABASE sales_db       TO ROLE sales_db_ro;
GRANT SELECT ON ALL VIEWS IN DATABASE sales_db           TO ROLE sales_db_ro;
GRANT SELECT ON FUTURE VIEWS IN DATABASE sales_db        TO ROLE sales_db_ro;

/* Access role: read-write (inherits read-only) */
GRANT ROLE sales_db_ro TO ROLE sales_db_rw;
GRANT INSERT, UPDATE, DELETE, TRUNCATE ON FUTURE TABLES IN DATABASE sales_db TO ROLE sales_db_rw;
GRANT CREATE TABLE, CREATE VIEW, CREATE STREAM, CREATE TASK
      ON SCHEMA sales_db.curated TO ROLE sales_db_rw;

/* Functional roles */
GRANT ROLE sales_db_rw TO ROLE data_engineer;
GRANT ROLE sales_db_ro TO ROLE analyst;
GRANT USAGE ON WAREHOUSE transform_wh TO ROLE data_engineer;
GRANT USAGE ON WAREHOUSE bi_wh        TO ROLE analyst;
GRANT ROLE data_engineer TO ROLE SYSADMIN;
GRANT ROLE analyst       TO ROLE SYSADMIN;

/* Task execution privilege */
USE ROLE ACCOUNTADMIN;
GRANT EXECUTE TASK, EXECUTE MANAGED TASK ON ACCOUNT TO ROLE data_engineer;

/* Users - service accounts should use key-pair auth, not passwords */
USE ROLE USERADMIN;
CREATE USER IF NOT EXISTS svc_etl
  TYPE = SERVICE
  DEFAULT_ROLE = data_engineer
  DEFAULT_WAREHOUSE = transform_wh
  RSA_PUBLIC_KEY = 'MIIBIjANBgkqh...';
USE ROLE SECURITYADMIN;
GRANT ROLE data_engineer TO USER svc_etl;

SHOW GRANTS TO ROLE data_engineer;
SHOW FUTURE GRANTS IN DATABASE sales_db;

/*
COLUMN-LEVEL SECURITY: MASKING POLICIES (Enterprise)
  - Policy is evaluated at query time based on role/context.
  - One policy can be reused on many columns.
  - Tag-based masking: attach the policy to a TAG; every column with that
    tag is masked automatically -> scales to thousands of PII columns.
*/
USE ROLE SYSADMIN;

CREATE OR REPLACE MASKING POLICY sales_db.curated.mp_email
AS (val STRING) RETURNS STRING ->
    CASE
        WHEN IS_ROLE_IN_SESSION('PII_READER') THEN val          -- full value
        WHEN IS_ROLE_IN_SESSION('ANALYST')
             THEN REGEXP_REPLACE(val, '^[^@]+', '*****')         -- *****@domain.com
        ELSE '***MASKED***'
    END;

ALTER TABLE sales_db.curated.dim_customer
    MODIFY COLUMN email SET MASKING POLICY sales_db.curated.mp_email;

/* Tag-based masking (alternative to the direct assignment above - if a
   column has BOTH, the directly assigned policy takes precedence) */
CREATE OR REPLACE TAG sales_db.curated.pii_type ALLOWED_VALUES 'EMAIL', 'PHONE', 'SSN';
ALTER TAG sales_db.curated.pii_type SET MASKING POLICY sales_db.curated.mp_email;
ALTER TABLE sales_db.curated.dim_customer MODIFY COLUMN email
    SET TAG sales_db.curated.pii_type = 'EMAIL';

/* Find all tagged columns */
SELECT * FROM TABLE(sales_db.INFORMATION_SCHEMA.TAG_REFERENCES_ALL_COLUMNS(
    'sales_db.curated.dim_customer', 'TABLE'));

/*
ROW-LEVEL SECURITY: ROW ACCESS POLICIES
  Mapping-table pattern: who can see which region.
*/
CREATE OR REPLACE TABLE sales_db.curated.region_access (role_name STRING, region STRING);
INSERT INTO sales_db.curated.region_access VALUES ('ANALYST_EAST', 'EAST'), ('ANALYST_WEST', 'WEST');

CREATE OR REPLACE ROW ACCESS POLICY sales_db.curated.rap_region
AS (p_region STRING) RETURNS BOOLEAN ->
    IS_ROLE_IN_SESSION('SYSADMIN')
    OR EXISTS (SELECT 1 FROM sales_db.curated.region_access a
               WHERE IS_ROLE_IN_SESSION(a.role_name) AND a.region = p_region);

ALTER TABLE sales_db.curated.orders ADD ROW ACCESS POLICY sales_db.curated.rap_region ON (region);

/* Network policy - restrict logins to corporate IP ranges */
USE ROLE SECURITYADMIN;
CREATE OR REPLACE NETWORK POLICY corp_only
  ALLOWED_IP_LIST = ('10.0.0.0/8', '203.0.113.0/24');
-- ALTER ACCOUNT SET NETWORK_POLICY = corp_only;       -- careful: can lock you out
ALTER USER svc_etl SET NETWORK_POLICY = corp_only;     -- or per user

