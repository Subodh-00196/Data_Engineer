-- ============================================================================
-- 35. READING THE QUERY PROFILE [***]
-- ============================================================================

/*
Open: Snowsight -> Monitoring -> Query History -> select query -> Query Profile

WHAT TO LOOK AT, IN ORDER
  +-----------------------------+--------------------------------------------+
  | Symptom in profile          | Meaning / Fix                              |
  +-----------------------------+--------------------------------------------+
  | Partitions scanned ≈ total  | Poor pruning -> add filter on clustered    |
  |                             | column, avoid functions on filter column,  |
  |                             | add clustering key / search optimization   |
  | Bytes spilled to LOCAL disk | Memory pressure -> bigger warehouse or     |
  |                             | reduce data earlier (filter/aggregate)     |
  | Bytes spilled to REMOTE     | Severe -> definitely size up or rewrite    |
  | Join output >> input rows   | "Exploding join" - missing/wrong join key, |
  |                             | duplicates in dimension; dedupe first      |
  | Most time in TableScan      | I/O bound -> pruning, select fewer columns |
  | Queued time high            | Concurrency -> multi-cluster / separate WH |
  | Remote disk I/O high        | Cold cache - expected after resume         |
  | Big Sort / Window operator  | Avoid unnecessary ORDER BY; pre-aggregate  |
  | Many UNION ALL / CTE reuse  | Materialize repeated CTEs into temp table  |
  +-----------------------------+--------------------------------------------+
*/

/* Same information via SQL */
SELECT query_id, warehouse_size, total_elapsed_time/1000 AS sec,
       partitions_scanned, partitions_total,
       ROUND(partitions_scanned / NULLIF(partitions_total,0) * 100, 1) AS pct_scanned,
       bytes_spilled_to_local_storage/POWER(1024,3)  AS gb_spilled_local,
       bytes_spilled_to_remote_storage/POWER(1024,3) AS gb_spilled_remote,
       queued_overload_time/1000 AS queued_sec
FROM SNOWFLAKE.ACCOUNT_USAGE.QUERY_HISTORY
WHERE start_time >= DATEADD(day, -1, CURRENT_TIMESTAMP())
  AND warehouse_name = 'TRANSFORM_WH'
ORDER BY total_elapsed_time DESC
LIMIT 20;

/* Operator-level stats for one query */
SELECT * FROM TABLE(GET_QUERY_OPERATOR_STATS(LAST_QUERY_ID()));

EXPLAIN USING TEXT
SELECT region, SUM(amount) FROM sales_db.curated.orders
WHERE order_date >= '2026-10-01' GROUP BY region;

-- ============================================================================
-- 36. CLUSTERING KEYS [***]
-- ============================================================================

/*
WHEN TO ADD A CLUSTERING KEY
  - Table is large (multi-TB / thousands of micro-partitions)
  - Queries filter on a predictable column (date, tenant, region)
  - Query Profile shows poor pruning
  - Table is queried much more than it is modified
  DON'T: small tables, very frequently updated tables, or high-cardinality
  keys like a UUID (expensive to maintain, little pruning benefit).

CHOOSING KEYS
  - Most-filtered columns first; usually 1-3 columns.
  - Order from LOWER to HIGHER cardinality.
  - Use expressions to reduce cardinality: CLUSTER BY (TO_DATE(event_ts))
    instead of the raw timestamp.

AUTOMATIC CLUSTERING
  - Background serverless service reclusters as data changes -> COSTS
    CREDITS. Monitor AUTOMATIC_CLUSTERING_HISTORY.
  - Cheapest alternative when possible: load data already sorted by the
    filter column (natural clustering) - no clustering key needed.
*/

ALTER TABLE sales_db.curated.orders CLUSTER BY (order_date, region);

SELECT SYSTEM$CLUSTERING_INFORMATION('sales_db.curated.orders');
-- key fields: average_overlaps, average_depth (lower is better),
--             partition_depth_histogram

ALTER TABLE sales_db.curated.orders SUSPEND RECLUSTER;    -- pause cost during backfills
ALTER TABLE sales_db.curated.orders RESUME RECLUSTER;
ALTER TABLE sales_db.curated.orders DROP CLUSTERING KEY;

/* Estimate cost before adding a key */
SELECT SYSTEM$ESTIMATE_AUTOMATIC_CLUSTERING_COSTS('sales_db.curated.orders', '(order_date)');

-- ============================================================================
-- 37. SEARCH OPTIMIZATION, QUERY ACCELERATION, MATERIALIZED VIEWS
-- ============================================================================

/*
SEARCH OPTIMIZATION SERVICE (SOS) - Enterprise
  - Builds a persistent "search access path" for point lookups:
    WHERE order_id = 123, IN lists, substring/LIKE, VARIANT field lookups,
    geospatial.
  - Clustering helps RANGE filters on 1 dimension; SOS helps NEEDLE-IN-
    HAYSTACK lookups on many columns.
  - Costs: extra storage + serverless maintenance credits.

QUERY ACCELERATION SERVICE (QAS) - Enterprise
  - Offloads parts of big scans/filters of OUTLIER queries to shared
    serverless compute, so one huge ad-hoc query doesn't need a bigger WH.
  - QUERY_ACCELERATION_MAX_SCALE_FACTOR caps the extra compute.

MATERIALIZED VIEWS - Enterprise
  - Precomputed, auto-maintained results of a SINGLE-table query
    (no joins, limited functions).
  - Optimizer can automatically rewrite queries to use the MV.
  - Background maintenance costs credits on every base-table change -
    best when the base table changes rarely and the MV is queried often.

MV vs DYNAMIC TABLE vs VIEW
  +---------------+--------------+-------------------+----------------------+
  |               | View         | Materialized View | Dynamic Table        |
  +---------------+--------------+-------------------+----------------------+
  | Stores data   | No           | Yes               | Yes                  |
  | Freshness     | Always live  | Always current    | Within TARGET_LAG    |
  | Joins         | Yes          | No                | Yes                  |
  | Compute       | Query time   | Serverless        | Your warehouse       |
  | Use for       | Abstraction  | Hot single-table  | Multi-step pipelines |
  |               |              | aggregates        |                      |
  +---------------+--------------+-------------------+----------------------+
*/

ALTER TABLE sales_db.curated.orders ADD SEARCH OPTIMIZATION ON EQUALITY(order_id, customer_id);
SELECT SYSTEM$ESTIMATE_SEARCH_OPTIMIZATION_COSTS('sales_db.curated.orders');

/* Is QAS worth it for this warehouse? */
SELECT * FROM SNOWFLAKE.ACCOUNT_USAGE.QUERY_ACCELERATION_ELIGIBLE
ORDER BY eligible_query_acceleration_time DESC LIMIT 20;

ALTER WAREHOUSE adhoc_wh SET ENABLE_QUERY_ACCELERATION = TRUE
                             QUERY_ACCELERATION_MAX_SCALE_FACTOR = 4;

CREATE OR REPLACE MATERIALIZED VIEW sales_db.mart.mv_daily_orders AS
SELECT order_date, COUNT(*) AS orders, SUM(amount) AS revenue
FROM sales_db.curated.orders
GROUP BY order_date;

-- ============================================================================
-- 38. QUERY WRITING BEST PRACTICES
-- ============================================================================

/*
  1. Select only needed columns (columnar storage - fewer columns = less I/O).
  2. Filter early and on clustered/naturally-ordered columns.
  3. Don't wrap filter columns in functions; compare with literal ranges.
  4. Deduplicate/aggregate BEFORE joining large tables.
  5. Use QUALIFY instead of self-joins for "latest row" logic.
  6. Avoid ORDER BY in subqueries/CTEs (only final output).
  7. UNION ALL instead of UNION when duplicates are impossible (no sort).
  8. Prefer set-based SQL over row-by-row loops/cursors.
  9. Use approximate functions for big exploratory counts:
     APPROX_COUNT_DISTINCT, APPROX_PERCENTILE.
 10. Batch DML: one MERGE of 1M rows >> 1M single-row updates.
 11. Use the right data types (dates as DATE, not strings) for pruning.
 12. Join on matching data types (no implicit casts on join keys).
*/

/* BAD - function on the filter column defeats pruning */
SELECT COUNT(*) FROM sales_db.curated.orders WHERE YEAR(order_date) = 2026;
/* GOOD */
SELECT COUNT(*) FROM sales_db.curated.orders
WHERE order_date >= '2026-01-01' AND order_date < '2027-01-01';

/* Fast distinct count on billions of rows (~1.6% error) */
SELECT APPROX_COUNT_DISTINCT(customer_id) FROM sales_db.curated.orders;

