-- ============================================================================
-- 39. SNOWFLAKE COST MODEL - WHAT YOU PAY FOR
-- ============================================================================

/*
  TOTAL COST = COMPUTE + STORAGE + DATA TRANSFER

  1. COMPUTE (usually 80-90% of the bill)
     a) Virtual warehouses  : credits/hour by size, billed per second,
                              60-second minimum per start/resume/resize-up
     b) Serverless features : Snowpipe, Snowpipe Streaming, serverless tasks,
                              automatic clustering, materialized views,
                              search optimization, query acceleration,
                              replication, data metric functions, Cortex AI
     c) Cloud services      : free up to 10% of DAILY warehouse credits;
                              only the excess is billed

  2. STORAGE (flat rate per TB per month, average compressed bytes)
     Active table data + Time Travel + Fail-safe + internal stage files +
     clones' changed data

  3. DATA TRANSFER
     Ingress: free. Egress to another region/cloud or the internet
     (unloading, replication, cross-region sharing) is billed per TB.
     Same-region transfers are free.

  CREDIT PRICE (approximate on-demand list, AWS US; varies by contract/region)
     Standard ~ $2 | Enterprise ~ $3 | Business Critical ~ $4 per credit
  STORAGE PRICE (approximate): ~$23/TB/month capacity, ~$40 on-demand (US)

  QUICK MATH EXAMPLE
     Medium warehouse = 4 credits/hr. Running 10 h/day on Enterprise:
     4 x 10 x 30 days x $3 = $3,600 / month for ONE warehouse.
     10 TB storage x $23 = $230 / month.
  => In most accounts, COMPUTE is where optimization pays off.
*/

-- ============================================================================
-- 40. COMPUTE COST OPTIMIZATION [***]
-- ============================================================================

/*
LEVER 1 - AUTO_SUSPEND (biggest quick win)
  Example: a job runs 5 minutes every hour on a Medium (4 credits/hr).
    AUTO_SUSPEND = 600 (10 min): billed 15 min/hour -> 1.0 credit/hr -> 24/day
    AUTO_SUSPEND = 60  (1 min) : billed  6 min/hour -> 0.4 credit/hr -> 9.6/day
    => 60% saving with one parameter.
  Guidance: ETL/loading WH 60s; BI WH 300-600s (keeps SSD cache warm for
  dashboards); never 0/NULL (= never suspend) unless truly 24x7.

LEVER 2 - RIGHT-SIZE THE WAREHOUSE
  - Bigger is not always more expensive: if a query takes 40 min on M
    (4 cr/h = 2.67 credits) and 20 min on L (8 cr/h = 2.67 credits), cost is
    the SAME and you get results 2x faster.
  - Stop sizing up when runtime stops halving (no more parallelism) - then
    you pay 2x for the same speed.
  - Spilling to remote storage = undersized; tiny queries on XL = oversized.
  - Method: run the workload on S, M, L; plot runtime vs credits; pick the
    knee of the curve.

LEVER 3 - CONSOLIDATE & ISOLATE CORRECTLY
  - Too many small warehouses each paying the 60s minimum and idle time
    -> consolidate low-volume workloads.
  - But keep separation where SLAs differ (BI vs ELT).
  - Multi-cluster with ECONOMY policy for cost-sensitive concurrency.
  - MAX_CLUSTER_COUNT caps worst-case spend.

LEVER 4 - REDUCE WORK
  - Incremental processing (streams, DTs, MERGE) instead of full reloads.
  - Better pruning (clustering / sorted loads / correct filters).
  - Avoid SELECT * on wide tables; filter early.
  - Reuse the result cache (consistent query text in BI tools; avoid
    CURRENT_TIMESTAMP() in dashboard SQL).
  - Use WHEN SYSTEM$STREAM_HAS_DATA so tasks don't start warehouses for
    nothing.

LEVER 5 - USE SERVERLESS WHERE IT IS CHEAPER
  - Short frequent tasks (seconds) -> serverless tasks avoid the 60s minimum
    and idle time.
  - Steady small file trickle -> Snowpipe instead of a warehouse polling.
  - Long, heavy, predictable jobs -> user-managed warehouse is often cheaper
    (serverless has a price multiplier).

LEVER 6 - GUARDRAILS
  - STATEMENT_TIMEOUT_IN_SECONDS on every warehouse (runaway queries)
  - STATEMENT_QUEUED_TIMEOUT_IN_SECONDS for BI
  - Resource monitors + budgets (section 44)
  - Restrict who can create/resize warehouses (MODIFY/CREATE WAREHOUSE)

LEVER 7 - TAG & ATTRIBUTE
  - QUERY_TAG per pipeline / dbt model; object TAGs on warehouses
    (cost_center) -> chargeback/showback to teams.
*/

ALTER WAREHOUSE load_wh      SET AUTO_SUSPEND = 60;
ALTER WAREHOUSE transform_wh SET AUTO_SUSPEND = 60 STATEMENT_TIMEOUT_IN_SECONDS = 7200;
ALTER WAREHOUSE bi_wh        SET AUTO_SUSPEND = 300 SCALING_POLICY = 'ECONOMY';

/* Tag sessions so cost can be attributed per pipeline */
ALTER SESSION SET QUERY_TAG = 'pipeline=orders;layer=curated';

/* Tag warehouses for chargeback */
CREATE TAG IF NOT EXISTS sales_db.audit.cost_center;
ALTER WAREHOUSE transform_wh SET TAG sales_db.audit.cost_center = 'data_engineering';
ALTER WAREHOUSE bi_wh        SET TAG sales_db.audit.cost_center = 'analytics';

-- ============================================================================
-- 41. STORAGE COST OPTIMIZATION
-- ============================================================================

/*
  1. TRANSIENT tables/schemas for raw, staging, and rebuildable data
     (no Fail-safe; Time Travel max 1 day).
  2. Lower DATA_RETENTION_TIME_IN_DAYS where 90 days isn't required
     (e.g. 7 days on curated, 1 day on staging).
  3. Avoid full TRUNCATE+RELOAD of big permanent tables daily - every reload
     keeps old micro-partitions in Time Travel + Fail-safe. Load incrementally.
  4. Drop unused tables, old clones, and backup copies (check ACCESS_HISTORY).
  5. PURGE = TRUE or REMOVE files from internal stages after loading.
  6. Long-lived clones that diverge from the source accumulate storage.
  7. Excessive reclustering rewrites partitions -> more Time Travel bytes.
  8. Archive cold data to S3 (unload / Iceberg / external tables) if it is
     rarely queried.
*/

/* Where is storage going? (active vs Time Travel vs Fail-safe) */
SELECT table_catalog || '.' || table_schema || '.' || table_name AS table_fqn,
       is_transient,
       ROUND(active_bytes      / POWER(1024,4), 3) AS active_tb,
       ROUND(time_travel_bytes / POWER(1024,4), 3) AS time_travel_tb,
       ROUND(failsafe_bytes    / POWER(1024,4), 3) AS failsafe_tb,
       ROUND(retained_for_clone_bytes / POWER(1024,4), 3) AS clone_tb
FROM SNOWFLAKE.ACCOUNT_USAGE.TABLE_STORAGE_METRICS
WHERE deleted = FALSE
ORDER BY (time_travel_bytes + failsafe_bytes) DESC
LIMIT 20;
-- If time_travel_tb + failsafe_tb >> active_tb, the table churns heavily:
-- consider TRANSIENT, lower retention, or incremental loads.

/* Tables nobody has read in 90 days (needs Enterprise ACCESS_HISTORY) */
WITH last_access AS (
    SELECT obj.value:"objectName"::STRING AS table_fqn,
           MAX(query_start_time)          AS last_read
    FROM SNOWFLAKE.ACCOUNT_USAGE.ACCESS_HISTORY,
         LATERAL FLATTEN(base_objects_accessed) obj
    WHERE obj.value:"objectDomain"::STRING = 'Table'
    GROUP BY 1
)
SELECT m.table_catalog || '.' || m.table_schema || '.' || m.table_name AS table_fqn,
       ROUND(m.active_bytes / POWER(1024,3), 1) AS active_gb,
       a.last_read
FROM SNOWFLAKE.ACCOUNT_USAGE.TABLE_STORAGE_METRICS m
LEFT JOIN last_access a
       ON UPPER(a.table_fqn) = UPPER(m.table_catalog || '.' || m.table_schema || '.' || m.table_name)
WHERE m.deleted = FALSE
  AND (a.last_read IS NULL OR a.last_read < DATEADD(day, -90, CURRENT_TIMESTAMP()))
ORDER BY m.active_bytes DESC;

/* Storage trend for the account */
SELECT usage_date,
       ROUND(storage_bytes  / POWER(1024,4), 2) AS table_tb,
       ROUND(stage_bytes    / POWER(1024,4), 2) AS stage_tb,
       ROUND(failsafe_bytes / POWER(1024,4), 2) AS failsafe_tb
FROM SNOWFLAKE.ACCOUNT_USAGE.STORAGE_USAGE
ORDER BY usage_date DESC
LIMIT 30;

ALTER SCHEMA sales_db.stage SET DATA_RETENTION_TIME_IN_DAYS = 1;

-- ============================================================================
-- 42. SERVERLESS FEATURE COSTS
-- ============================================================================

/*
  +-------------------------+---------------------------------+-----------------------------------+
  | Feature                 | Cost driver                     | Monitor (ACCOUNT_USAGE view)      |
  +-------------------------+---------------------------------+-----------------------------------+
  | Snowpipe                | files + data volume             | PIPE_USAGE_HISTORY                |
  | Automatic clustering    | how much data changes / churn   | AUTOMATIC_CLUSTERING_HISTORY      |
  | Materialized views      | base table changes              | MATERIALIZED_VIEW_REFRESH_HISTORY |
  | Search optimization     | build + maintenance + storage   | SEARCH_OPTIMIZATION_HISTORY       |
  | Serverless tasks        | task runtime                    | SERVERLESS_TASK_HISTORY           |
  | Query acceleration      | offloaded scan work             | QUERY_ACCELERATION_HISTORY        |
  | Replication             | changed data + transfer         | REPLICATION_GROUP_USAGE_HISTORY   |
  | Dynamic tables          | refreshes on YOUR warehouse     | (warehouse metering) +            |
  |                         |                                 | DYNAMIC_TABLE_REFRESH_HISTORY     |
  +-------------------------+---------------------------------+-----------------------------------+

  KEY POINT [***]: Resource monitors only control USER-MANAGED WAREHOUSES.
  They do NOT stop serverless features - use Budgets + monitoring for those.
*/

/* All credits by service type (warehouses, pipes, clustering, ...) */
SELECT service_type,
       ROUND(SUM(credits_used_compute), 2)          AS compute_credits,
       ROUND(SUM(credits_used_cloud_services), 2)   AS cloud_services_credits,
       ROUND(SUM(credits_adjustment_cloud_services), 2) AS cloud_services_free_adjustment,
       ROUND(SUM(credits_billed), 2)                AS credits_billed
FROM SNOWFLAKE.ACCOUNT_USAGE.METERING_DAILY_HISTORY
WHERE usage_date >= DATEADD(day, -30, CURRENT_DATE())
GROUP BY service_type
ORDER BY credits_billed DESC;

/* Automatic clustering spend by table */
SELECT database_name || '.' || schema_name || '.' || table_name AS table_fqn,
       ROUND(SUM(credits_used), 2) AS credits,
       SUM(num_rows_reclustered)   AS rows_reclustered
FROM SNOWFLAKE.ACCOUNT_USAGE.AUTOMATIC_CLUSTERING_HISTORY
WHERE start_time >= DATEADD(day, -30, CURRENT_TIMESTAMP())
GROUP BY 1 ORDER BY credits DESC;

/* Serverless task spend */
SELECT task_name, ROUND(SUM(credits_used), 2) AS credits
FROM SNOWFLAKE.ACCOUNT_USAGE.SERVERLESS_TASK_HISTORY
WHERE start_time >= DATEADD(day, -30, CURRENT_TIMESTAMP())
GROUP BY task_name ORDER BY credits DESC;

-- ============================================================================
-- 43. COST MONITORING QUERIES (ACCOUNT_USAGE) [***]
-- ============================================================================

/*
  ACCOUNT_USAGE (SNOWFLAKE database): 365 days of history, latency
  ~45 min to 3 hours, includes dropped objects.
  INFORMATION_SCHEMA: near real-time, 7 days to 6 months depending on the
  function, current database only.
  ORGANIZATION_USAGE: across all accounts, includes cost in currency.
*/

/* 1. Warehouse credits - last 30 days */
SELECT warehouse_name,
       ROUND(SUM(credits_used), 1)                 AS total_credits,
       ROUND(SUM(credits_used_compute), 1)         AS compute_credits,
       ROUND(SUM(credits_used_cloud_services), 1)  AS cloud_services_credits
FROM SNOWFLAKE.ACCOUNT_USAGE.WAREHOUSE_METERING_HISTORY
WHERE start_time >= DATEADD(day, -30, CURRENT_TIMESTAMP())
GROUP BY warehouse_name
ORDER BY total_credits DESC;

/* 2. Most expensive queries (per-query credit attribution, excludes idle time) */
SELECT q.query_id, q.warehouse_name, q.user_name, q.query_tag,
       ROUND(q.credits_attributed_compute, 4) AS credits,
       LEFT(h.query_text, 120)                AS query_text
FROM SNOWFLAKE.ACCOUNT_USAGE.QUERY_ATTRIBUTION_HISTORY q
JOIN SNOWFLAKE.ACCOUNT_USAGE.QUERY_HISTORY h USING (query_id)
WHERE q.start_time >= DATEADD(day, -7, CURRENT_TIMESTAMP())
ORDER BY credits DESC
LIMIT 25;

/* 3. Cost per pipeline via QUERY_TAG */
SELECT query_tag, ROUND(SUM(credits_attributed_compute), 2) AS credits
FROM SNOWFLAKE.ACCOUNT_USAGE.QUERY_ATTRIBUTION_HISTORY
WHERE start_time >= DATEADD(day, -30, CURRENT_TIMESTAMP())
GROUP BY query_tag ORDER BY credits DESC;

/* 4. IDLE cost: credits billed vs credits actually used by queries */
WITH billed AS (
    SELECT warehouse_name, SUM(credits_used_compute) AS billed_credits
    FROM SNOWFLAKE.ACCOUNT_USAGE.WAREHOUSE_METERING_HISTORY
    WHERE start_time >= DATEADD(day, -30, CURRENT_TIMESTAMP())
    GROUP BY warehouse_name
), used AS (
    SELECT warehouse_name, SUM(credits_attributed_compute) AS query_credits
    FROM SNOWFLAKE.ACCOUNT_USAGE.QUERY_ATTRIBUTION_HISTORY
    WHERE start_time >= DATEADD(day, -30, CURRENT_TIMESTAMP())
    GROUP BY warehouse_name
)
SELECT b.warehouse_name,
       ROUND(b.billed_credits, 1)                         AS billed,
       ROUND(COALESCE(u.query_credits, 0), 1)             AS used_by_queries,
       ROUND(100 * (1 - COALESCE(u.query_credits,0) / NULLIF(b.billed_credits,0)), 1) AS idle_pct
FROM billed b LEFT JOIN used u USING (warehouse_name)
ORDER BY idle_pct DESC;
-- High idle_pct -> lower AUTO_SUSPEND or consolidate the warehouse.

/* 5. Warehouses with suspicious settings */
SHOW WAREHOUSES;
SELECT "name", "size", "auto_suspend", "min_cluster_count", "max_cluster_count", "scaling_policy"
FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))
WHERE "auto_suspend" IS NULL OR "auto_suspend" = 0 OR "auto_suspend" > 600;

/* 6. Hourly load pattern (find idle hours / schedule overlap) */
SELECT warehouse_name, HOUR(start_time) AS hour_of_day,
       ROUND(AVG(credits_used), 2) AS avg_credits
FROM SNOWFLAKE.ACCOUNT_USAGE.WAREHOUSE_METERING_HISTORY
WHERE start_time >= DATEADD(day, -14, CURRENT_TIMESTAMP())
GROUP BY 1, 2 ORDER BY 1, 2;

/* 7. Repeated identical expensive queries (candidates for caching / DT / MV) */
SELECT query_parameterized_hash, COUNT(*) AS executions,
       ROUND(AVG(total_elapsed_time)/1000, 1) AS avg_sec,
       ANY_VALUE(LEFT(query_text, 120)) AS sample_text
FROM SNOWFLAKE.ACCOUNT_USAGE.QUERY_HISTORY
WHERE start_time >= DATEADD(day, -7, CURRENT_TIMESTAMP())
  AND execution_status = 'SUCCESS'
GROUP BY query_parameterized_hash
HAVING COUNT(*) > 50
ORDER BY executions * avg_sec DESC
LIMIT 20;

/* 8. Cost in currency across the organization */
SELECT usage_date, account_name, usage_type, ROUND(SUM(usage_in_currency), 2) AS cost
FROM SNOWFLAKE.ORGANIZATION_USAGE.USAGE_IN_CURRENCY_DAILY
WHERE usage_date >= DATEADD(day, -30, CURRENT_DATE())
GROUP BY 1, 2, 3 ORDER BY 1 DESC, cost DESC;

-- ============================================================================
-- 44. RESOURCE MONITORS, BUDGETS & GUARDRAILS
-- ============================================================================

/*
RESOURCE MONITOR
  - Tracks credits of user-managed WAREHOUSES against a quota per interval
    (DAILY / WEEKLY / MONTHLY / YEARLY / NEVER).
  - Actions at thresholds:
      NOTIFY              email account admins (who enabled notifications)
      SUSPEND             suspend after running queries finish
      SUSPEND_IMMEDIATE   suspend and cancel running queries
  - Assign at account level (one) and/or per warehouse (one monitor per WH).
  - Cannot control serverless features.

BUDGETS
  - Monthly spending limit for the account or a custom group of objects
    (warehouses, tables with serverless features, pipes...), with
    notifications when spend is projected to exceed the limit.
  - Complements resource monitors (which only cover warehouses).
*/

USE ROLE ACCOUNTADMIN;

CREATE OR REPLACE RESOURCE MONITOR rm_transform
WITH CREDIT_QUOTA = 500
     FREQUENCY = MONTHLY
     START_TIMESTAMP = IMMEDIATELY
     TRIGGERS
        ON 75  PERCENT DO NOTIFY
        ON 90  PERCENT DO NOTIFY
        ON 100 PERCENT DO SUSPEND
        ON 110 PERCENT DO SUSPEND_IMMEDIATE;

ALTER WAREHOUSE transform_wh SET RESOURCE_MONITOR = rm_transform;

CREATE OR REPLACE RESOURCE MONITOR rm_account
WITH CREDIT_QUOTA = 5000 FREQUENCY = MONTHLY START_TIMESTAMP = IMMEDIATELY
     TRIGGERS ON 80 PERCENT DO NOTIFY ON 100 PERCENT DO NOTIFY;
ALTER ACCOUNT SET RESOURCE_MONITOR = rm_account;

SHOW RESOURCE MONITORS;

/* Custom budget for the data engineering objects */
CREATE SNOWFLAKE.CORE.BUDGET sales_db.audit.de_budget();
CALL sales_db.audit.de_budget!SET_SPENDING_LIMIT(1500);           -- credits per month
CALL sales_db.audit.de_budget!SET_EMAIL_NOTIFICATIONS('email_int', 'de-team@company.com');
CALL sales_db.audit.de_budget!ADD_RESOURCE(
    SELECT SYSTEM$REFERENCE('WAREHOUSE', 'transform_wh', 'SESSION', 'APPLYBUDGET'));

/* Guardrails at account level */
ALTER ACCOUNT SET STATEMENT_TIMEOUT_IN_SECONDS = 14400;            -- 4h max anywhere
ALTER USER svc_etl SET STATEMENT_TIMEOUT_IN_SECONDS = 7200;

