-- ============================================================================
-- 30. TIME TRAVEL & FAIL-SAFE [***]
-- ============================================================================

/*
DATA LIFECYCLE OF A CHANGED/DELETED MICRO-PARTITION

  [ACTIVE] --change/delete--> [TIME TRAVEL] --retention ends--> [FAIL-SAFE] --7 days--> gone
                               0-90 days (user)                  7 days (Snowflake
                               query, clone, UNDROP              support only)

  - DATA_RETENTION_TIME_IN_DAYS: Standard max 1, Enterprise+ max 90
    (permanent tables); transient/temporary max 1.
  - Set at account / database / schema / table - most specific wins.
  - Fail-safe: 7 days, permanent tables only, NOT user-accessible,
    NOT configurable.
  - BOTH Time Travel and Fail-safe bytes are billed as storage. [cost!]
  - Setting retention to 0 disables Time Travel (and stream support
    becomes fragile - streams depend on retention).

COST EXAMPLE [***]
  A 2 TB table fully rewritten every day (e.g. TRUNCATE + reload) with
  90-day retention keeps ~90 old copies + 7 days Fail-safe
  => up to ~194 TB billed instead of 2 TB.
  Fix: make it TRANSIENT with 0-1 day retention, or load incrementally.
*/

/* Query the past */
SELECT * FROM sales_db.curated.orders AT (OFFSET => -60*30);                      -- 30 min ago
SELECT * FROM sales_db.curated.orders AT (TIMESTAMP => '2026-10-14 08:00:00'::TIMESTAMP_LTZ);
SELECT * FROM sales_db.curated.orders BEFORE (STATEMENT => '01b7c3a2-0000-1234-0000-00a1b2c3d4e5');

/* Recover from a bad DELETE/UPDATE: clone the past version, then swap */
CREATE OR REPLACE TABLE sales_db.curated.orders_restore
    CLONE sales_db.curated.orders
    BEFORE (STATEMENT => '01b7c3a2-0000-1234-0000-00a1b2c3d4e5');
ALTER TABLE sales_db.curated.orders SWAP WITH sales_db.curated.orders_restore;

/* Or re-insert only the deleted rows */
INSERT INTO sales_db.curated.orders
SELECT * FROM sales_db.curated.orders BEFORE (STATEMENT => '01b7c3a2-0000-1234-0000-00a1b2c3d4e5')
MINUS
SELECT * FROM sales_db.curated.orders;

/* Recover dropped objects */
DROP TABLE sales_db.curated.orders_backup;
UNDROP TABLE sales_db.curated.orders_backup;
SHOW TABLES HISTORY LIKE 'orders%' IN SCHEMA sales_db.curated;   -- see dropped versions

/* Retention settings */
ALTER TABLE sales_db.curated.orders SET DATA_RETENTION_TIME_IN_DAYS = 30;
ALTER SCHEMA sales_db.stage SET DATA_RETENTION_TIME_IN_DAYS = 1;

-- ============================================================================
-- 31. ZERO-COPY CLONING
-- ============================================================================

/*
HOW IT WORKS
  A clone copies only METADATA (pointers to the same micro-partitions).
  Instant and free at creation; storage is billed only for micro-partitions
  that change afterwards in either object (copy-on-write).

WHAT GETS CLONED (database/schema clone)
  - Tables, views, sequences, file formats, procedures, functions,
    streams, tasks, external stages, pipes on external stages
  - Cloned TASKS are SUSPENDED by default
  - Cloned STREAMS: unconsumed records in the clone's streams are not
    accessible (offset starts fresh)
  - Privileges: child objects keep their grants in a db/schema clone;
    a cloned TABLE alone does not copy grants unless COPY GRANTS is used
  - Internal named stages and their files are not cloned (by default)

USE CASES
  - Instant DEV/QA environments from PROD
  - Safe backup before a risky migration or backfill
  - Point-in-time snapshot (CLONE ... AT/BEFORE)
  - Blue/green deployments with SWAP
*/

CREATE TABLE sales_db.curated.orders_pre_release CLONE sales_db.curated.orders;
CREATE SCHEMA sales_db.curated_snapshot_20261015 CLONE sales_db.curated;
CREATE TABLE sales_db.curated.orders_yesterday CLONE sales_db.curated.orders
    AT (OFFSET => -86400) COPY GRANTS;

