-- ============================================================================
-- 24. BACKFILLS, LATE-ARRIVING DATA & REPROCESSING [***]
-- ============================================================================

/*
HISTORICAL BACKFILL (e.g. 2 years / 20 TB of files already in S3)
  - Use COPY INTO with a dedicated, temporarily LARGER warehouse - not
    Snowpipe (pipe REFRESH only looks back 7 days, and per-file overhead
    makes huge backfills more expensive).
  - Split the work by prefix/PATTERN (one month at a time) so failures are
    small and restartable; COPY load metadata makes reruns safe.
  - Load into a separate table, validate counts, then ALTER TABLE ... SWAP
    WITH the production table (zero downtime).
  - Suspend downstream tasks/DTs during the backfill to avoid repeated
    incremental refreshes, then resume.
  - Load files sorted by date so the table is naturally clustered.

LATE-ARRIVING DATA
  - Drive incremental logic by LOAD time (load_ts / stream), not by event
    time - a record for last week that arrives today is still picked up.
  - MERGE handles late updates naturally (compare updated_at).
  - Aggregates: recompute a sliding window (e.g. last 3 days) each run,
    or use DYNAMIC TABLES which incrementally update affected groups.
  - SCD2: late changes require inserting a version "in the middle" of
    history - adjust effective_to of the neighbouring versions.

REPROCESSING / RECOVERY OPTIONS
  - Bug in transformation logic: fix the code, then rebuild CURATED from
    RAW (raw keeps the full payload) -> INSERT OVERWRITE or rebuild + SWAP.
  - Bad data merged an hour ago: restore with Time Travel
    (CREATE TABLE ... CLONE ... AT/BEFORE) then SWAP.
  - Stream went stale: recreate stream, reconcile the gap using
    CHANGES clause / Time Travel or reload from RAW by load_ts range.
*/

/* Parameterised monthly backfill loop */
CREATE OR REPLACE PROCEDURE sales_db.raw.sp_backfill_orders(p_start DATE, p_end DATE)
RETURNS STRING
LANGUAGE SQL
AS
$$
DECLARE
    v_month DATE := DATE_TRUNC('month', p_start);
    v_sql   STRING;
BEGIN
    WHILE (v_month <= p_end) DO
        v_sql := 'COPY INTO sales_db.raw.raw_orders (record, src_file, src_row, file_ts) ' ||
                 'FROM (SELECT $1, METADATA$FILENAME, METADATA$FILE_ROW_NUMBER, ' ||
                 '      METADATA$FILE_LAST_MODIFIED ' ||
                 '      FROM @sales_db.raw.ext_s3_stage/orders/' ||
                 TO_VARCHAR(v_month, 'YYYY/MM') || '/) ' ||
                 'FILE_FORMAT = (FORMAT_NAME = ''sales_db.raw.json_ff'') ' ||
                 'ON_ERROR = ''SKIP_FILE''';
        EXECUTE IMMEDIATE :v_sql;
        v_month := DATEADD(month, 1, v_month);
    END WHILE;
    RETURN 'Backfill complete';
END;
$$;

