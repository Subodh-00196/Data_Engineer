CREATE OR REPLACE FUNCTION sales_db.curated.f_amount_band(amount NUMBER)
RETURNS STRING
AS
$$
    CASE WHEN amount >= 1000 THEN 'HIGH'
         WHEN amount >= 100  THEN 'MEDIUM'
         ELSE 'LOW' END
