-- ============================================================================
-- 1. WHAT IS SNOWFLAKE, EDITIONS & OBJECT HIERARCHY
-- ============================================================================

/*
WHAT IS SNOWFLAKE?
  A fully managed, cloud-native data platform delivered as SaaS. There is no
  hardware or software to install, no indexes to manage, no vacuuming, and no
  manual partitioning. It runs on AWS, Azure or GCP (this guide uses AWS).

  Key differentiator: STORAGE and COMPUTE are SEPARATED. You pay for them
  independently and can scale each one without affecting the other.

EDITIONS (each includes everything in the edition above it):
  +----------------------+-------------------------------------------------+
  | Standard             | Core platform, Time Travel up to 1 day          |
  | Enterprise           | + Multi-cluster warehouses, Time Travel 90 days,|
  |                      |   Materialized Views, Search Optimization,      |
  |                      |   Masking/Row Access policies, Query Accel.,    |
  |                      |   ACCESS_HISTORY                                |
  | Business Critical    | + HIPAA/PCI support, Tri-Secret Secure,         |
  |                      |   AWS PrivateLink, failover/failback            |
  | Virtual Private (VPS)| + Completely isolated Snowflake environment     |
  +----------------------+-------------------------------------------------+
  INTERVIEW TIP: Healthcare (PHI/HIPAA) workloads typically need
  Business Critical.

OBJECT HIERARCHY:
  ORGANIZATION
    └── ACCOUNT  (tied to one cloud + region, e.g. AWS us-east-1)
          ├── USERS, ROLES, WAREHOUSES, RESOURCE MONITORS,
          │   INTEGRATIONS, NETWORK POLICIES        (account-level objects)
          └── DATABASE
                └── SCHEMA
                      ├── TABLES, VIEWS, STAGES, FILE FORMATS
                      ├── STREAMS, TASKS, PIPES, DYNAMIC TABLES
                      └── PROCEDURES, FUNCTIONS, SEQUENCES, POLICIES, TAGS

  Fully qualified name:  database.schema.object   e.g. sales_db.raw.raw_orders
*/

USE ROLE SYSADMIN;
CREATE DATABASE IF NOT EXISTS sales_db;
CREATE SCHEMA IF NOT EXISTS sales_db.raw;
CREATE SCHEMA IF NOT EXISTS sales_db.stage;
CREATE SCHEMA IF NOT EXISTS sales_db.curated;
CREATE SCHEMA IF NOT EXISTS sales_db.mart;
USE SCHEMA sales_db.raw;

/* Context functions - handy in debugging and in policies */
SELECT CURRENT_ACCOUNT(), CURRENT_REGION(), CURRENT_ROLE(),
       CURRENT_WAREHOUSE(), CURRENT_DATABASE(), CURRENT_SCHEMA();

-- ============================================================================
-- 2. DATA TYPES & SEMI-STRUCTURED DATA
-- ============================================================================

/*
COMMON DATA TYPES
  Numeric        : NUMBER(p,s) (INT/INTEGER = NUMBER(38,0)), FLOAT
  String         : VARCHAR (STRING, TEXT are synonyms). Max length does NOT
                   affect storage or performance - VARCHAR(10) and VARCHAR
                   cost the same.
  Date/Time      : DATE, TIME, TIMESTAMP_NTZ, TIMESTAMP_LTZ, TIMESTAMP_TZ
  Semi-structured: VARIANT (any JSON value), OBJECT (key/value), ARRAY
  Other          : BOOLEAN, BINARY, GEOGRAPHY, GEOMETRY, VECTOR

TIMESTAMP FLAVORS (frequently asked)
  TIMESTAMP_NTZ : "wall clock" - no time zone stored (default for TIMESTAMP)
  TIMESTAMP_LTZ : stored in UTC, displayed in the session's time zone
  TIMESTAMP_TZ  : stored in UTC + the original offset
  TIP: Store event times as TIMESTAMP_NTZ in UTC or TIMESTAMP_TZ - be
       consistent across the pipeline.

WHY VARIANT MATTERS FOR DATA ENGINEERS
  - Land raw JSON as-is in a VARIANT column (schema-on-read).
  - Snowflake automatically extracts common JSON paths into hidden columnar
    sub-columns, so querying payload:field is nearly as fast as a normal column.
  - Lets the pipeline survive source schema changes: new JSON keys do not
    break the load.
*/

CREATE OR REPLACE TABLE events (payload VARIANT);

INSERT INTO events
SELECT PARSE_JSON('{
    "order_id": 101,
    "customer": {"id": 5, "name": "Alice"},
    "items": [ {"sku": "A1", "qty": 2}, {"sku": "B7", "qty": 1} ],
    "order_ts": "2026-10-01 10:15:00"
}');

/* Access JSON fields:  column:key.subkey[index]::type */
SELECT
    payload:order_id::INT              AS order_id,
    payload:customer.name::STRING      AS customer_name,
    payload:items[0].sku::STRING       AS first_sku,
    payload:order_ts::TIMESTAMP_NTZ    AS order_ts
FROM events;

/* FLATTEN - turn each array element into its own row [***]
   One order with 2 items  ->  2 rows                              */
SELECT
    e.payload:order_id::INT   AS order_id,
    i.value:sku::STRING       AS sku,
    i.value:qty::INT          AS qty,
    i.index                   AS item_position
FROM events e,
     LATERAL FLATTEN(INPUT => e.payload:items) i;
/* Result:
   ORDER_ID | SKU | QTY | ITEM_POSITION
   101      | A1  | 2   | 0
   101      | B7  | 1   | 1                                         */

/* OUTER => TRUE keeps the parent row even when the array is empty/missing
   (like a LEFT JOIN). Without it, orders with no items disappear.  */
SELECT e.payload:order_id::INT, i.value:sku::STRING
FROM events e,
     LATERAL FLATTEN(INPUT => e.payload:items, OUTER => TRUE) i;

/* Build JSON from relational data */
SELECT OBJECT_CONSTRUCT('id', 1, 'name', 'Alice')    AS obj,
       ARRAY_AGG(sku) WITHIN GROUP (ORDER BY sku)    AS skus
FROM (SELECT 'A1' AS sku UNION ALL SELECT 'B7');

/* Safe conversion - returns NULL instead of failing the whole query */
SELECT TRY_TO_NUMBER('abc'), TRY_TO_DATE('2026-13-45'), TRY_PARSE_JSON('{bad');

