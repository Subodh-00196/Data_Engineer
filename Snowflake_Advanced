-- 3. TABLE TYPES & VIEW TYPES
-- ============================================================================

/*
TABLE TYPES
  +------------+--------------+-----------+---------------+------------------+
  | Type       | Time Travel  | Fail-safe | Lifespan      | Typical use      |
  +------------+--------------+-----------+---------------+------------------+
  | Permanent  | 0-90 days    | 7 days    | until dropped | curated / prod   |
  | Transient  | 0-1 day      | NONE      | until dropped | raw / staging    |
  | Temporary  | 0-1 day      | NONE      | session only  | scratch work     |
  | External   | none         | none      | files in S3   | query data lake  |
  | Iceberg    | yes (Iceberg)| none      | files in S3   | open table format|
  | Hybrid     | yes          | yes       | until dropped | OLTP-style row   |
  |            |              |           |               | lookups (Unistore)|
  | Dynamic    | yes          | yes       | until dropped | declarative ELT  |
  +------------+--------------+-----------+---------------+------------------+

  COST TIP [***]: Staging and raw tables that can be re-loaded from S3 should
  be TRANSIENT - you avoid paying 7 days of Fail-safe storage on data that
  churns daily. A schema or database can be created TRANSIENT so all tables
  in it default to transient.

VIEW TYPES
  Standard view      - stored query, no storage, always current
  Secure view        - hides definition + prevents optimizer leaks; required
                       for data sharing; can be slightly slower
  Materialized view  - stores results, auto-maintained (Enterprise)
  (see section 37 for MV vs Dynamic Table comparison)
*/

CREATE TRANSIENT SCHEMA IF NOT EXISTS sales_db.landing;   -- all tables transient

CREATE OR REPLACE TRANSIENT TABLE sales_db.stage.stg_tmp (id INT, val STRING);
CREATE OR REPLACE TEMPORARY TABLE session_scratch (id INT);

CREATE OR REPLACE SECURE VIEW sales_db.mart.v_orders_us AS
SELECT order_id, order_ts, amount
FROM sales_db.curated.orders
WHERE region = 'US';


