/* Python UDF */
CREATE OR REPLACE FUNCTION sales_db.curated.f_mask_email(email STRING)
RETURNS STRING
LANGUAGE PYTHON
RUNTIME_VERSION = '3.11'
HANDLER = 'mask'
AS
$$
def mask(email):
    if not email or '@' not in email:
        return email
    user, domain = email.split('@', 1)
    return user[0] + '***@' + domain
$$;

-- ============================================================================
-- 28. WINDOW FUNCTIONS & QUALIFY
-- ============================================================================

/*
  QUALIFY filters on window-function results (like HAVING for GROUP BY).
  Most-used in pipelines: ROW_NUMBER for dedup / latest record.
  ROW_NUMBER  1,2,3,4   always unique
  RANK        1,2,2,4   ties share rank, gaps after
  DENSE_RANK  1,2,2,3   ties share rank, no gaps
*/

/* Latest record per key - THE most common pipeline pattern */
SELECT *
FROM sales_db.stage.stg_orders
QUALIFY ROW_NUMBER() OVER (PARTITION BY order_id ORDER BY updated_at DESC) = 1;

/* Running total, previous value, 7-row moving average */
SELECT
    customer_id, order_date, amount,
    SUM(amount) OVER (PARTITION BY customer_id ORDER BY order_date
                      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS running_total,
    LAG(amount) OVER (PARTITION BY customer_id ORDER BY order_date)     AS prev_amount,
    AVG(amount) OVER (PARTITION BY customer_id ORDER BY order_date
                      ROWS BETWEEN 6 PRECEDING AND CURRENT ROW)         AS moving_avg_7
FROM sales_db.curated.orders;

/* Top 3 orders per region */
SELECT region, order_id, amount
FROM sales_db.curated.orders
QUALIFY DENSE_RANK() OVER (PARTITION BY region ORDER BY amount DESC) <= 3;

/* Gaps & islands: consecutive days a customer ordered */
SELECT customer_id, MIN(order_date) AS streak_start, MAX(order_date) AS streak_end,
       COUNT(*) AS days
FROM (
    SELECT DISTINCT customer_id, order_date,
           DATEADD(day, -DENSE_RANK() OVER (PARTITION BY customer_id ORDER BY order_date),
                   order_date) AS grp
    FROM sales_db.curated.orders
)
GROUP BY customer_id, grp;

-- ============================================================================
-- 29. SEQUENCES & TRANSACTIONS
-- ============================================================================

/*
SEQUENCES / AUTOINCREMENT
  - Generate unique numbers, but NOT gap-free and NOT guaranteed in insert
    order. Never use them to detect missing records.
  - For surrogate keys, AUTOINCREMENT/IDENTITY or a sequence default is fine;
    for deterministic keys across environments use HASH/MD5 of business key.

TRANSACTIONS
  - Autocommit is ON by default: every statement commits on its own.
  - BEGIN ... COMMIT / ROLLBACK groups DML statements atomically.
  - DDL (CREATE/ALTER/DROP) commits implicitly - avoid DDL inside a
    transaction you may need to roll back.
  - Isolation level: READ COMMITTED. Each statement sees data committed
    before it started.
  - Concurrent DML on the same table can block (table-level locks for
    UPDATE/DELETE/MERGE); INSERTs generally do not block each other.
    LOCK_TIMEOUT (default 12 hours) controls how long a statement waits.
*/

CREATE OR REPLACE SEQUENCE sales_db.curated.seq_order_sk START = 1 INCREMENT = 1;
SELECT sales_db.curated.seq_order_sk.NEXTVAL;

BEGIN TRANSACTION;
    UPDATE sales_db.curated.orders SET status = 'CANCELLED' WHERE order_id = 101;
    INSERT INTO sales_db.audit.pipeline_run_log (run_id, pipeline, status, start_ts)
    VALUES (UUID_STRING(), 'manual_cancel', 'SUCCESS', CURRENT_TIMESTAMP());
COMMIT;

SHOW LOCKS;                     -- who is blocking whom
SHOW TRANSACTIONS;


