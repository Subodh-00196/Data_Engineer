-- 32. REPLICATION & DISASTER RECOVERY
-- ============================================================================

/*
  - Replicate databases AND account objects (users, roles, warehouses,
    integrations, network policies) to another region/cloud.
  - REPLICATION GROUP : read-only secondary copies (e.g. for reporting in
    another region).
  - FAILOVER GROUP    : secondary can be PROMOTED to primary during an outage
    (Business Critical+).
  - CLIENT REDIRECT / connection URLs let apps switch without code changes.
  - Cost: serverless compute for refresh + data transfer between regions
    + storage in the target account. Refresh only what you need.
  - RPO = replication schedule interval; RTO = time to fail over (minutes).
*/

CREATE FAILOVER GROUP sales_fg
  OBJECT_TYPES = DATABASES, ROLES, WAREHOUSES, INTEGRATIONS
  ALLOWED_DATABASES = sales_db
  ALLOWED_INTEGRATION_TYPES = STORAGE INTEGRATIONS
  ALLOWED_ACCOUNTS = myorg.dr_account_us_west
  REPLICATION_SCHEDULE = '10 MINUTE';

