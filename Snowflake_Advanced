/* Export to S3 as Parquet, partitioned by date folders */
COPY INTO @ext_s3_stage/exports/orders/
FROM (SELECT order_id, customer_id, amount, order_date
      FROM sales_db.curated.orders
      WHERE order_date >= DATEADD(day, -7, CURRENT_DATE()))
PARTITION BY ('order_date=' || TO_VARCHAR(order_date, 'YYYY-MM-DD'))
