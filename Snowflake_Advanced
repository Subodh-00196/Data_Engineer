    TASK_NAME => 't_root_daily', RECURSIVE => TRUE));

-- ============================================================================
-- 19. DYNAMIC TABLES [***]
-- ============================================================================

/*
WHAT IS A DYNAMIC TABLE (DT)?
  A table defined by a SELECT. You declare the result and how FRESH it must
  be (TARGET_LAG); Snowflake schedules refreshes, tracks dependencies, and
  refreshes INCREMENTALLY (only changed data) when possible.
  => Replaces a lot of Stream + Task + MERGE plumbing.

KEY SETTINGS
  TARGET_LAG   = '5 minutes' | '1 hour' | DOWNSTREAM
                 DOWNSTREAM = refresh only when a downstream DT needs it
  WAREHOUSE    = compute used for refreshes (you pay warehouse credits)
  REFRESH_MODE = AUTO (default) | INCREMENTAL | FULL
  INITIALIZE   = ON_CREATE (default) | ON_SCHEDULE

INCREMENTAL vs FULL REFRESH
  - Incremental: processes only changed source rows; cheapest.
  - Full: recomputes everything; happens if the query uses constructs that
    cannot be incrementalized (some non-deterministic functions, certain
    complex operators). Check REFRESH_MODE / REFRESH_MODE_REASON in
    SHOW DYNAMIC TABLES and pin REFRESH_MODE = INCREMENTAL to fail fast.
  - If sources have not changed, the refresh is skipped.

STREAMS+TASKS vs DYNAMIC TABLES  [*** common question]
  +----------------------+------------------------------+--------------------+
  |                      | Streams + Tasks              | Dynamic Tables     |
  +----------------------+------------------------------+--------------------+
  | Style                | Imperative (you write MERGE) | Declarative SELECT |
  | Scheduling           | You define schedule/DAG      | TARGET_LAG, auto   |
  | Dependency mgmt      | Manual (AFTER)               | Automatic          |
  | Procedural logic     | Yes (procs, IF, loops, APIs) | No - SQL only      |
  | SCD2 / deletes logic | Full control                 | Limited            |
  | Side effects         | Yes (notifications, unload)  | No                 |
  | Best for             | Complex, custom CDC logic    | Joins/aggregations |
  |                      |                              | in medallion layers|
  +----------------------+------------------------------+--------------------+
*/

CREATE OR REPLACE DYNAMIC TABLE sales_db.mart.daily_revenue
  TARGET_LAG = '30 minutes'
  WAREHOUSE  = transform_wh
  REFRESH_MODE = INCREMENTAL
AS
SELECT o.order_date,
       c.region,
       COUNT(*)        AS order_count,
       SUM(o.amount)   AS revenue
FROM sales_db.curated.orders o
JOIN sales_db.curated.dim_customer c
  ON o.customer_id = c.customer_id AND c.is_current
GROUP BY o.order_date, c.region;

/* Chain: intermediate DT refreshes only when the final DT needs it */
CREATE OR REPLACE DYNAMIC TABLE sales_db.mart.region_revenue_mtd
  TARGET_LAG = '1 hour'
  WAREHOUSE  = transform_wh
AS
SELECT region, SUM(revenue) AS revenue_mtd
FROM sales_db.mart.daily_revenue
WHERE order_date >= DATE_TRUNC('month', CURRENT_DATE())
GROUP BY region;

ALTER DYNAMIC TABLE sales_db.mart.daily_revenue REFRESH;    -- manual refresh
ALTER DYNAMIC TABLE sales_db.mart.daily_revenue SUSPEND;    -- stop refreshes (cost)
ALTER DYNAMIC TABLE sales_db.mart.daily_revenue RESUME;

SHOW DYNAMIC TABLES IN SCHEMA sales_db.mart;   -- refresh_mode, refresh_mode_reason, data_timestamp

SELECT name, state, refresh_action, refresh_trigger,
       refresh_start_time, refresh_end_time, state_message
FROM TABLE(INFORMATION_SCHEMA.DYNAMIC_TABLE_REFRESH_HISTORY(
    NAME => 'SALES_DB.MART.DAILY_REVENUE'))
ORDER BY refresh_start_time DESC;

-- ============================================================================
-- 20. MERGE, INCREMENTAL LOADS & DEDUPLICATION [***]
-- ============================================================================

/*
INCREMENTAL LOAD STRATEGIES
  1. Stream-based CDC      : process only rows in the stream (best inside SF)
  2. High-watermark        : WHERE updated_at > (SELECT MAX(updated_at) FROM tgt)
                             - use LOAD time, not event time, if data can
                               arrive late (see section 24)
  3. Hash comparison       : compare HASH(cols) to detect changed rows when
                             source has no reliable timestamp
  4. INSERT OVERWRITE      : rebuild a small table / partition atomically
  5. Dynamic table         : let Snowflake handle incrementality

MERGE GOTCHAS [***]
  - DUPLICATE SOURCE KEYS: if two source rows match one target row, MERGE
    fails with "Duplicate row detected during DML action"
    (ERROR_ON_NONDETERMINISTIC_MERGE = TRUE by default).
    -> ALWAYS deduplicate the source with QUALIFY ROW_NUMBER() first.
  - PERFORMANCE: MERGE scans the target to find matches. Add a pruning
    predicate on the target's clustering column into the ON clause
    (e.g. only last 7 days) so it does not scan the whole table.
  - Do not MERGE row-by-row in a loop - one set-based MERGE per batch.
*/

/* Standard upsert with dedup + conditional update */
MERGE INTO sales_db.curated.orders t
USING (
    SELECT *
    FROM sales_db.stage.stg_orders
    QUALIFY ROW_NUMBER() OVER (PARTITION BY order_id ORDER BY updated_at DESC) = 1
) s
ON t.order_id = s.order_id
WHEN MATCHED AND s.is_deleted THEN DELETE
WHEN MATCHED AND s.updated_at > t.updated_at THEN UPDATE SET
     t.status     = s.status,
     t.amount     = s.amount,
     t.updated_at = s.updated_at
WHEN NOT MATCHED AND NOT s.is_deleted THEN INSERT
     (order_id, customer_id, order_date, status, amount, updated_at)
     VALUES (s.order_id, s.customer_id, s.order_date, s.status, s.amount, s.updated_at);

/* MERGE with target pruning - only touch recent partitions */
MERGE INTO sales_db.curated.orders t
USING sales_db.stage.stg_orders s
ON  t.order_id = s.order_id
AND t.order_date >= DATEADD(day, -7, CURRENT_DATE())   -- prunes target micro-partitions
WHEN MATCHED THEN UPDATE SET t.status = s.status, t.updated_at = s.updated_at
WHEN NOT MATCHED THEN INSERT (order_id, customer_id, order_date, status, amount, updated_at)
     VALUES (s.order_id, s.customer_id, s.order_date, s.status, s.amount, s.updated_at);
/* Caution: only safe if updates never arrive for orders older than 7 days;
   otherwise those would be inserted as duplicates. */

/* Hash-based change detection */
MERGE INTO sales_db.curated.customers_scd1 t
USING (
    SELECT customer_id, name, email, region,
           HASH(name, email, region) AS row_hash
    FROM sales_db.stage.customers
    QUALIFY ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY updated_at DESC) = 1
) s
ON t.customer_id = s.customer_id
WHEN MATCHED AND t.row_hash <> s.row_hash THEN UPDATE SET
     t.name = s.name, t.email = s.email, t.region = s.region, t.row_hash = s.row_hash
WHEN NOT MATCHED THEN INSERT (customer_id, name, email, region, row_hash)
     VALUES (s.customer_id, s.name, s.email, s.region, s.row_hash);

/* Atomic full refresh of a small table (truncate + insert in one statement) */
INSERT OVERWRITE INTO sales_db.mart.top_customers
SELECT customer_id, SUM(amount) AS total
FROM sales_db.curated.orders
GROUP BY customer_id
ORDER BY total DESC
LIMIT 100;

/* Find duplicates in a table */
SELECT order_id, COUNT(*) AS cnt
FROM sales_db.curated.orders
GROUP BY order_id HAVING COUNT(*) > 1;

/* Remove exact/near duplicates - rebuild keeping the latest row per key */
CREATE OR REPLACE TABLE sales_db.curated.orders_backup CLONE sales_db.curated.orders;  -- safety copy
INSERT OVERWRITE INTO sales_db.curated.orders
SELECT * FROM sales_db.curated.orders
QUALIFY ROW_NUMBER() OVER (PARTITION BY order_id ORDER BY updated_at DESC) = 1;

-- ============================================================================
-- 21. SCD TYPE 1 & TYPE 2 [***]
-- ============================================================================

/*
SCD TYPE 1 : overwrite - keep only the latest values (MERGE upsert above).
SCD TYPE 2 : keep full history - expire the old row, insert a new version.

  customer_sk | customer_id | region | effective_from | effective_to | is_current
  1           | 5           | EAST   | 2025-01-01     | 2026-09-30   | FALSE
  2           | 5           | WEST   | 2026-10-01     | 9999-12-31   | TRUE

SINGLE-STATEMENT SCD2 MERGE (the "UNION ALL trick") [***]
  A MERGE can either UPDATE or INSERT a matched row - not both. For a
  changed customer we need BOTH (expire old + insert new). Solution:
  feed each changed record TWICE:
    - copy 1 with merge_key = customer_id  -> MATCHES current row -> expire it
    - copy 2 with merge_key = NULL         -> never matches      -> insert new version
  New customers come once (merge_key = id, no match) -> inserted.
*/

CREATE OR REPLACE TABLE sales_db.curated.dim_customer (
    customer_sk     NUMBER AUTOINCREMENT,
    customer_id     NUMBER,
    name            STRING,
    email           STRING,
    region          STRING,
    row_hash        NUMBER,
    effective_from  TIMESTAMP_NTZ,
    effective_to    TIMESTAMP_NTZ,
    is_current      BOOLEAN
);

CREATE OR REPLACE PROCEDURE sales_db.curated.sp_scd2_customer()
RETURNS STRING
LANGUAGE SQL
AS
$$
BEGIN
    MERGE INTO sales_db.curated.dim_customer t
    USING (
        -- latest change per customer from the stream
        WITH src AS (
            SELECT customer_id, name, email, region, updated_at,
                   HASH(name, email, region) AS row_hash
            FROM sales_db.stage.customers_stream
            WHERE METADATA$ACTION = 'INSERT'
            QUALIFY ROW_NUMBER() OVER (PARTITION BY customer_id
                                       ORDER BY updated_at DESC) = 1
        )
        -- copy 1: used to match & expire the current row (or insert if new)
        SELECT customer_id AS merge_key, src.* FROM src
        UNION ALL
        -- copy 2: changed customers only, NULL key -> always inserted
        SELECT NULL AS merge_key, src.*
        FROM src
        JOIN sales_db.curated.dim_customer d
          ON d.customer_id = src.customer_id
         AND d.is_current
         AND d.row_hash <> src.row_hash
    ) s
    ON t.customer_id = s.merge_key AND t.is_current
    WHEN MATCHED AND t.row_hash <> s.row_hash THEN UPDATE SET
         t.effective_to = s.updated_at,
         t.is_current   = FALSE
    WHEN NOT MATCHED THEN INSERT
         (customer_id, name, email, region, row_hash,
          effective_from, effective_to, is_current)
         VALUES (s.customer_id, s.name, s.email, s.region, s.row_hash,
                 s.updated_at, '9999-12-31'::TIMESTAMP_NTZ, TRUE);

    RETURN 'SCD2 merge complete: ' || SQLROWCOUNT || ' rows affected';
END;
$$;

/* Point-in-time lookup: which region was customer 5 in on 2026-06-15? */
SELECT region
FROM sales_db.curated.dim_customer
WHERE customer_id = 5
  AND '2026-06-15'::TIMESTAMP_NTZ >= effective_from
  AND '2026-06-15'::TIMESTAMP_NTZ <  effective_to;

-- ============================================================================
-- 22. END-TO-END PIPELINE: S3 -> RAW -> STAGE -> CURATED -> MART [***]
-- ============================================================================

/*
REFERENCE ARCHITECTURE (Medallion: Bronze / Silver / Gold)

  S3 (orders/*.json.gz)
     │  S3 event -> SQS
     ▼
  [Snowpipe: orders_pipe]  ─────────────── serverless ingestion
     ▼
  RAW.raw_orders (TRANSIENT, VARIANT + file lineage)        = BRONZE
     │  APPEND-ONLY STREAM raw_orders_stream
     ▼
  [Triggered TASK t_on_new_orders -> CALL sp_process_orders()]
     │   1. flatten + type-cast + validate  -> STAGE.stg_orders
     │   2. bad rows                        -> AUDIT.rejected_orders
     │   3. dedupe + MERGE                  -> CURATED.orders      = SILVER
     │   4. log run                         -> AUDIT.pipeline_run_log
     ▼
  MART.daily_revenue (DYNAMIC TABLE, TARGET_LAG 30 min)     = GOLD
     ▼
  BI tools (bi_wh)

DESIGN DECISIONS TO EXPLAIN IN AN INTERVIEW
  - RAW keeps the untouched payload -> can REPLAY / reprocess anytime.
  - RAW is TRANSIENT: data is reproducible from S3, so no Fail-safe cost.
  - APPEND-ONLY stream: raw is insert-only, cheaper than a standard stream.
  - Processing in ONE TRANSACTION: if the MERGE fails, the stream offset
    does not move -> the next run retries the same data (no data loss,
    no duplicates).
  - MERGE keyed on order_id -> re-running is IDEMPOTENT.
  - Separate warehouses: Snowpipe (serverless), transform_wh, bi_wh.
*/

CREATE SCHEMA IF NOT EXISTS sales_db.audit;

CREATE OR REPLACE TABLE sales_db.audit.pipeline_run_log (
    run_id        STRING,
    pipeline      STRING,
    status        STRING,          -- RUNNING / SUCCESS / FAILED
    rows_staged   NUMBER,
    rows_rejected NUMBER,
    rows_merged   NUMBER,
    error_message STRING,
    start_ts      TIMESTAMP_LTZ,
    end_ts        TIMESTAMP_LTZ
);

CREATE OR REPLACE TABLE sales_db.audit.rejected_orders (
    run_id STRING, record VARIANT, src_file STRING, reason STRING,
    rejected_ts TIMESTAMP_LTZ DEFAULT CURRENT_TIMESTAMP()
);

CREATE OR REPLACE TRANSIENT TABLE sales_db.stage.stg_orders (
    run_id STRING, order_id NUMBER, customer_id NUMBER, order_date DATE,
    status STRING, amount NUMBER(12,2), is_deleted BOOLEAN,
    updated_at TIMESTAMP_NTZ, src_file STRING
);

CREATE OR REPLACE TABLE sales_db.curated.orders (
    order_id NUMBER, customer_id NUMBER, order_date DATE, status STRING,
    amount NUMBER(12,2), updated_at TIMESTAMP_NTZ, region STRING,
    load_ts TIMESTAMP_LTZ DEFAULT CURRENT_TIMESTAMP()
)
CLUSTER BY (order_date);       -- only worth it once the table is multi-TB

CREATE OR REPLACE PROCEDURE sales_db.curated.sp_process_orders()
RETURNS STRING
LANGUAGE SQL
EXECUTE AS OWNER
AS
$$
DECLARE
    v_run_id    STRING := UUID_STRING();
    v_staged    NUMBER := 0;
    v_rejected  NUMBER := 0;
    v_merged    NUMBER := 0;
BEGIN
    INSERT INTO sales_db.audit.pipeline_run_log (run_id, pipeline, status, start_ts)
    VALUES (:v_run_id, 'orders', 'RUNNING', CURRENT_TIMESTAMP());

    DELETE FROM sales_db.stage.stg_orders;

    BEGIN TRANSACTION;

    -- Multi-table INSERT: read the stream ONCE, route good vs bad rows
    INSERT ALL
        WHEN is_valid THEN
            INTO sales_db.stage.stg_orders
                 (run_id, order_id, customer_id, order_date, status,
                  amount, is_deleted, updated_at, src_file)
            VALUES (run_id, order_id, customer_id, order_date, status,
                    amount, is_deleted, updated_at, src_file)
        ELSE
            INTO sales_db.audit.rejected_orders (run_id, record, src_file, reason)
            VALUES (run_id, record, src_file, reason)
    SELECT
        :v_run_id                                      AS run_id,
        record,
        src_file,
        TRY_TO_NUMBER(record:order_id::STRING)         AS order_id,
        TRY_TO_NUMBER(record:customer_id::STRING)      AS customer_id,
        TRY_TO_DATE(record:order_ts::STRING)           AS order_date,
        UPPER(record:status::STRING)                   AS status,
        TRY_TO_NUMBER(record:amount::STRING, 12, 2)    AS amount,
        COALESCE(record:is_deleted::BOOLEAN, FALSE)    AS is_deleted,
        TRY_TO_TIMESTAMP_NTZ(record:updated_at::STRING) AS updated_at,
        (order_id IS NOT NULL AND order_date IS NOT NULL
         AND amount IS NOT NULL AND amount >= 0)       AS is_valid,
        CASE WHEN order_id   IS NULL THEN 'missing/invalid order_id'
             WHEN order_date IS NULL THEN 'missing/invalid order_ts'
             WHEN amount     IS NULL THEN 'missing/invalid amount'
             WHEN amount < 0         THEN 'negative amount'
        END                                            AS reason
    FROM sales_db.raw.raw_orders_stream;

    SELECT COUNT(*) INTO :v_staged FROM sales_db.stage.stg_orders;
    SELECT COUNT(*) INTO :v_rejected FROM sales_db.audit.rejected_orders
    WHERE run_id = :v_run_id;

    MERGE INTO sales_db.curated.orders t
    USING (
        SELECT * FROM sales_db.stage.stg_orders
        QUALIFY ROW_NUMBER() OVER (PARTITION BY order_id
                                   ORDER BY updated_at DESC) = 1
    ) s
    ON t.order_id = s.order_id
    WHEN MATCHED AND s.is_deleted THEN DELETE
    WHEN MATCHED AND s.updated_at > t.updated_at THEN UPDATE SET
         t.status = s.status, t.amount = s.amount, t.updated_at = s.updated_at
    WHEN NOT MATCHED AND NOT s.is_deleted THEN INSERT
         (order_id, customer_id, order_date, status, amount, updated_at)
         VALUES (s.order_id, s.customer_id, s.order_date, s.status,
                 s.amount, s.updated_at);

    v_merged := SQLROWCOUNT;

    COMMIT;                                     -- stream offset advances here

    UPDATE sales_db.audit.pipeline_run_log
    SET status = 'SUCCESS', rows_staged = :v_staged, rows_rejected = :v_rejected,
        rows_merged = :v_merged, end_ts = CURRENT_TIMESTAMP()
    WHERE run_id = :v_run_id;

    RETURN 'SUCCESS run_id=' || v_run_id || ' merged=' || v_merged;

EXCEPTION
    WHEN OTHER THEN
        ROLLBACK;                               -- stream offset NOT advanced
        LET v_err STRING := SQLERRM;
        UPDATE sales_db.audit.pipeline_run_log
        SET status = 'FAILED', error_message = :v_err, end_ts = CURRENT_TIMESTAMP()
        WHERE run_id = :v_run_id;
        RAISE;                                  -- task shows FAILED -> alerts fire
END;
$$;

/* Wire it up (triggered task from section 18) and turn it on */
ALTER TASK sales_db.raw.t_on_new_orders RESUME;

-- ============================================================================
-- 23. ERROR HANDLING, IDEMPOTENCY, AUDIT & DATA QUALITY [***]
-- ============================================================================

/*
IDEMPOTENCY CHECKLIST - "re-running the pipeline must not create duplicates"
  [x] COPY/Snowpipe load metadata skips already-loaded files
  [x] Never use FORCE = TRUE in scheduled jobs
  [x] Use MERGE on a business key, not blind INSERT
  [x] Deduplicate the source batch (QUALIFY) before MERGE
  [x] Consume streams inside a transaction - failure = no offset move
  [x] For full rebuilds use INSERT OVERWRITE or build-then-SWAP
  [x] Log every run with a run_id; make backfills parameter-driven

ERROR HANDLING LAYERS
  1. File level      : ON_ERROR, VALIDATION_MODE, VALIDATE(), COPY_HISTORY
  2. Row level       : TRY_ functions + quarantine table (rejected_orders)
  3. Statement level : EXCEPTION blocks in procedures, ROLLBACK, RAISE
  4. Orchestration   : task retries, SUSPEND_TASK_AFTER_NUM_FAILURES,
                       finalizer tasks, error integrations (SNS)
  5. Monitoring      : ALERTS on audit tables / TASK_HISTORY, email/SNS
*/

